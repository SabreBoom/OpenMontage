{%- comment -%}
  The pair offer as data, for the scripts that need it without Liquid (the
  cart drawer's pair offer). Rendered once per page, by
  snippets/cart-drawer.liquid. Prices and variants come from the real
  products; the saving and the discount title from Theme settings > Offers,
  which have to match the automatic discount in Discounts.

  The rule the scripts apply is window.ZorevPair.applies (assets/zorev.js):
  with G units of A and H units of B in the bag after an add, Shopify gives
  the pair saving, once per order, when G >= 1 and H >= 1 and (H <= 2 or
  G >= H). Measured against the real cart, not assumed.

  Pictures: the same clean packshot the pair band stands on its plate
  (snippets/pair-offer, mode 'img', output 'url'): the option's studio
  picture with a measured box, cut to the product — for HOYGI that is the
  stick-and-box cutout (studio slot 6), never the busy lifestyle photo
  (slot 5), which turns to mud at 56 px. Else the option's first studio
  picture, else its own Shopify image, else the product's. "image" on a and
  b is the first available option's; each variant carries its own for a
  chooser that swaps it. The retired generated cutouts (zorev.cutouts) are
  not read.
{%- endcomment -%}
{%- liquid
  assign pa = settings.pair_product_a
  assign pb = settings.pair_product_b
-%}
{%- if settings.pair_enabled and pa != blank and pb != blank and pa.title != blank and pb.title != blank -%}
{%- liquid
  assign va = pa.selected_or_first_available_variant
  assign vb = pb.selected_or_first_available_variant
  capture img_a
    render 'pair-offer', mode: 'img', product: pa, variant: va, output: 'url', url_width: 240
  endcapture
  capture img_b
    render 'pair-offer', mode: 'img', product: pb, variant: vb, output: 'url', url_width: 240
  endcapture
  assign img_a = img_a | strip
  assign img_b = img_b | strip
-%}
<script type="application/json" data-pair-config>
{
  "save": {{ settings.pair_save_cents | default: 0 | json }},
  "title": {{ settings.pair_discount_title | json }},
  "name": {{ settings.pair_name | json }},
  "tagline": {{ settings.pair_tagline | json }},
  "a": {
    "id": {{ pa.id | json }}, "short": {{ pa.vendor | upcase | json }}, "title": {{ pa.title | json }},
    "url": {{ pa.url | json }}, "price": {{ pa.price | json }},
    "image": {% if img_a != blank %}{{ img_a | json }}{% else %}null{% endif %},
    "variants": [{%- for v in pa.variants -%}{%- capture vl -%}{% render 'zvlabel', t: v.title %}{%- endcapture -%}{%- capture vi -%}{% render 'pair-offer', mode: 'img', product: pa, variant: v, output: 'url', url_width: 240 %}{%- endcapture -%}{%- assign vi = vi | strip -%}{"id":{{ v.id }},"title":{{ vl | strip | json }},"available":{{ v.available }},"image":{% if vi != blank %}{{ vi | json }}{% else %}null{% endif %}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
  },
  "b": {
    "id": {{ pb.id | json }}, "short": {{ pb.vendor | upcase | json }}, "title": {{ pb.title | json }},
    "url": {{ pb.url | json }}, "price": {{ pb.price | json }},
    "image": {% if img_b != blank %}{{ img_b | json }}{% else %}null{% endif %},
    "variants": [{%- for v in pb.variants -%}{%- capture vl -%}{% render 'zvlabel', t: v.title %}{%- endcapture -%}{%- capture vi -%}{% render 'pair-offer', mode: 'img', product: pb, variant: v, output: 'url', url_width: 240 %}{%- endcapture -%}{%- assign vi = vi | strip -%}{"id":{{ v.id }},"title":{{ vl | strip | json }},"available":{{ v.available }},"image":{% if vi != blank %}{{ vi | json }}{% else %}null{% endif %}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
  }
}
</script>
{%- endif -%}
