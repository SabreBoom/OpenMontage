{%- comment -%}
  The clean cutouts as data, for the scripts that paint product images
  without Liquid: the cart drawer (which paints lines from /cart.js). One
  small JSON per page — product id -> variant id -> image URL — read by
  zorev.js. Products without cutouts are simply absent, and the drawer then
  uses the line's own Shopify image as before.

  Bounded to the first 24 products: this catalogue has two, and the loop
  must never become the slow part of a page.
{%- endcomment -%}
<script type="application/json" data-cutout-map>
{
{%- assign first_p = true -%}
{%- for p in collections.all.products limit: 24 -%}
  {%- assign cuts = p.metafields.zorev.cutouts.value -%}
  {%- if cuts.size > 0 -%}
    {%- comment -%}
      The file list iterates but does not index (cuts[i] is not an image),
      so the URLs are resolved once in a loop into a plain array first.
    {%- endcomment -%}
    {%- capture cut_urls -%}{%- for c in cuts -%}{{ c | image_url: width: 160 }}{%- unless forloop.last -%}|{%- endunless -%}{%- endfor -%}{%- endcapture -%}
    {%- assign cut_urls = cut_urls | split: '|' -%}
    {%- unless first_p -%},{%- endunless -%}{%- assign first_p = false -%}
    "{{ p.id }}": {
    {%- for v in p.variants -%}
      {%- assign ci = forloop.index0 -%}
      {%- if ci >= cut_urls.size -%}{%- assign ci = cut_urls.size | minus: 1 -%}{%- endif -%}
      "{{ v.id }}": {{ cut_urls[ci] | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
    }
  {%- endif -%}
{%- endfor -%}
}
</script>
