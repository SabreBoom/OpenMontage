{%- comment -%}
  Product photographs as data, for the scripts that paint product images
  without Liquid: the cart drawer (which paints lines from /cart.js). One
  small JSON per page — product id -> variant id -> image URL — read by
  zorev.js. V14: the URL is the photograph assigned to the option in
  Shopify (the variant's image), else the product's featured image — the
  same picture snippets/product-cutout shows everywhere else. A product
  with no photographs is simply absent, and the drawer then uses the
  line's own Shopify image.

  Bounded to the first 24 products: this catalogue has two, and the loop
  must never become the slow part of a page.
{%- endcomment -%}
<script type="application/json" data-cutout-map>
{
{%- assign first_p = true -%}
{%- for p in collections.all.products limit: 24 -%}
  {%- if p.featured_media -%}
    {%- unless first_p -%},{%- endunless -%}{%- assign first_p = false -%}
    "{{ p.id }}": {
    {%- for v in p.variants -%}
      {%- assign vimg = v.featured_media.preview_image | default: p.featured_media.preview_image -%}
      "{{ v.id }}": {{ vimg | image_url: width: 160 | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
    }
  {%- endif -%}
{%- endfor -%}
}
</script>
