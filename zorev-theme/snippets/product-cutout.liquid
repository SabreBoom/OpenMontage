{%- comment -%}
  One product photograph (V14).

    {% render 'product-cutout', product: p, index: 0, sizes: '(min-width: 900px) 40vw, 90vw', eager: false, alt: 'GODA bottle and box' %}

  Shows the store's own photograph from Shopify: the image assigned to the
  chosen option (Products > the product > the variant's image), else the
  product's featured image. Whatever is uploaded in Shopify admin is what
  the site shows, everywhere a product appears: the hero card, the line-up,
  the pair, the story cards and the bag. The name stays "product-cutout" so
  every caller keeps working unchanged; the generated cutouts
  (zorev.cutouts) are no longer read.

  index      which option, usually the selected variant's index. An index
             past the last option falls back to the featured image.
  eager      true for the LCP candidate only.
  vt_static  true for the one picture that carries the page-to-page name
             from the markup (the product page's first picture). Every
             picture also says which product it is (data-vt-product), so the
             script in layout/theme.liquid can name the one that was tapped.
{%- endcomment -%}
{%- liquid
  assign i = index | default: 0
  assign img = nil
  if product.variants.size > i
    assign img = product.variants[i].featured_media.preview_image
  endif
  if img == blank
    assign img = product.featured_media.preview_image
  endif
  assign alt_text = alt | default: product.title
  assign sizes_attr = sizes | default: '(min-width: 900px) 40vw, 90vw'
-%}
{%- if img -%}
  <img class="zv-cut zv-photo{% if class != blank %} {{ class }}{% endif %}"
       src="{{ img | image_url: width: 900 }}"
       srcset="{{ img | image_url: width: 360 }} 360w, {{ img | image_url: width: 540 }} 540w, {{ img | image_url: width: 720 }} 720w, {{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1200 }} 1200w"
       sizes="{{ sizes_attr }}"
       width="{{ img.width | default: 1200 }}" height="{{ img.height | default: 1200 }}"
       alt="{{ alt_text | strip_html | escape }}"
       data-vt-product="{{ product.handle | escape }}"{% if vt_static %} data-vt-static{% endif %}
       {% if eager %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
{%- endif -%}
