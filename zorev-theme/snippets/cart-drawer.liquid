{%- comment -%}
  ZOREV — slide-out cart drawer.

  The shell is rendered server-side so the panel and its focus anchors exist
  before any JS runs; the lines themselves are painted from /cart.js by
  assets/zorev.js. That split matters: a drawer whose entire markup is
  client-built flashes empty on open, and a drawer built entirely in Liquid
  goes stale the moment a line changes.

  A modal dialog (a div with role=dialog, aria-modal): zorev.js keeps Tab
  and Shift+Tab inside the panel, makes the page behind it inert, closes on
  Escape and gives focus back to the control that opened it. Every control
  is a real <button>. With JS off the header cart link is an ordinary
  <a href="/cart"> and this never opens — the cart page is the fallback, not
  a dead end.

  Colours are tokens only (warm paper panel, stone footer, studio plates for
  the pictures), so the light edition and the dark rollback both hold.
{%- endcomment -%}
{%- liquid
  assign pa = settings.pair_product_a
  assign pb = settings.pair_product_b
  assign pair_on = false
  if settings.pair_enabled and pa != blank and pb != blank and pa.title != blank and pb.title != blank
    assign pair_on = true
  endif
-%}
{%- capture cd_pp -%}{% render 'pair-price' %}{%- endcapture -%}
{%- assign cd_pp = cd_pp | strip -%}

<div class="cd" id="cart-drawer" data-cart-drawer
     data-money-format="{{ shop.money_format | strip_html | escape }}"
     data-shop-currency="{{ shop.currency | escape }}"
     aria-hidden="true" hidden>

  <div class="cd__scrim" data-cd-close tabindex="-1"></div>

  <div class="cd__panel" role="dialog" aria-modal="true"
       aria-labelledby="cd-title" tabindex="-1">

    <div class="cd__head">
      <h2 class="cd__title" id="cd-title">Your bag</h2>
      <button class="cd__x" type="button" data-cd-close aria-label="Close bag">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
          <path d="M1 1l16 16M17 1L1 17" stroke="currentColor" stroke-width="1.5" fill="none"/>
        </svg>
      </button>
    </div>

    {%- comment -%}
      The pair offer follows the lines inside the same scrolling area, so it
      reads as the next line of the bag ("and this goes with it") instead of
      a card pinned above the total with empty space around it. It is still
      a sibling of the body zorev.js repaints, so it is never wiped
      mid-render. Filled by the script below from the real cart.
    {%- endcomment -%}
    <div class="cd__scroll">
      <p class="cd__err" role="alert" data-cd-err hidden></p>
      <div class="cd__body" data-cd-body>
        <p class="cd__loading fine">Loading your bag&hellip;</p>
      </div>
      <div class="cd__pair" data-cd-pair hidden></div>
    </div>

    <div class="cd__foot" data-cd-foot hidden>
      <div class="cd__savings" data-cd-savings hidden></div>
      <div class="cd__row">
        <span class="cd__rowk">Subtotal</span>
        <span class="cd__rowv" data-cd-subtotal>&mdash;</span>
      </div>
      <p class="cd__note fine">Shipping is free, worldwide. Taxes, where they apply, are shown at checkout.</p>
      <form action="{{ routes.cart_url }}" method="post">
        <button class="btn btn--block" type="submit" name="checkout">Checkout</button>
      </form>
      <a class="cd__link fine" href="{{ routes.cart_url }}">View full bag</a>
    </div>

    {%- comment -%} Announces line changes without moving focus. {%- endcomment -%}
    <p class="visually-hidden" role="status" aria-live="polite" data-cd-live></p>
  </div>

  {%- comment -%}
    The empty bag, cloned into the body by zorev.js. Server-rendered so its
    links follow the store's routes and the pair price is the same figure
    every other surface quotes (snippets/pair-price, currency-guarded).
  {%- endcomment -%}
  <template data-cd-empty>
    <div class="cd__empty">
      <p class="cd__emptyh" tabindex="-1" data-cd-empty-focus>Your bag is empty.</p>
      {%- if pair_on -%}
        <p class="cd__emptyp">Start with {{ pa.vendor | upcase | escape }} or {{ pb.vendor | upcase | escape }}, or take both as {{ settings.pair_name | escape }}{% if cd_pp != blank %}, {{ cd_pp }} together{% endif %}.</p>
      {%- endif -%}
      <div class="cd__emptyact">
        <a class="btn" href="{{ routes.all_products_collection_url }}">Shop ZOREV</a>
        {%- if pair_on -%}
          <a class="btn btn--ghost" href="{{ routes.root_url }}#pair">{{ settings.pair_name | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </template>
</div>


{% render 'pair-data' %}
{%- capture zic_check -%}{% render 'zicon', name: 'check' %}{%- endcapture -%}
<script>
/* The pair offer in the bag.

   It only ever claims a saving Shopify will actually give, using the one
   shared rule window.ZorevPair.applies(g, h) (assets/zorev.js): g = GODA,
   h = HOYGI units in the bag after the add. So:
     · Shopify applied the pair (its discount title is in the cart)
         → one quiet confirmation line
     · GODA, no HOYGI          → offer one HOYGI (always applies)
     · HOYGI (1 or 2), no GODA → offer one GODA  (applies up to two HOYGI)
     · both, but not applied, and the rule says it cannot be
       (three or more HOYGI with fewer GODA) → a neutral note, no offer
     · anything else           → nothing
   Money in the offer is shown only in the store's own currency; the bag's
   lines and totals are always Shopify's. */
(function () {
  'use strict';
  /* The icon arrives JSON-escaped: the snippet's markup has line breaks,
     and a raw newline inside a JS string literal is a syntax error. */
  var ICON_CHECK = {{ zic_check | strip_newlines | json }};
  var slot = document.querySelector('[data-cd-pair]');
  var cfgEl = document.querySelector('[data-pair-config]');
  if (!slot || !cfgEl) return;
  var cfg; try { cfg = JSON.parse(cfgEl.textContent); } catch (e) { return; }
  /* "Complete your ZOREV Pair", not "Complete your The ZOREV Pair". */
  var bare = String(cfg.name || '').replace(/^the\s+/i, '');
  var drawer = document.querySelector('[data-cart-drawer]');
  var shopCur = drawer ? drawer.getAttribute('data-shop-currency') : '';
  var fmt = drawer ? drawer.getAttribute('data-money-format') : null;
  if (fmt && fmt.indexOf('&') > -1) { var t = document.createElement('textarea'); t.innerHTML = fmt; fmt = t.value; }
  function money(c) { return window.ZorevMoney ? window.ZorevMoney(c, fmt) : '$' + (c / 100).toFixed(2); }
  /* Promotional figures read as "$8", "$47"; line prices and totals keep
     their cents because they are what the customer is charged. */
  function short(c) { var s = money(c); return c % 100 === 0 ? s.replace(/[.,]00(?=\D*$)/, '') : s; }
  function esc(x) { return String(x == null ? '' : x).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function applies(g, h) {
    if (window.ZorevPair) return window.ZorevPair.applies(g, h);
    return g >= 1 && h >= 1 && (h <= 2 || g >= h);
  }
  function media(id) { return window.ZorevCart && window.ZorevCart.media ? window.ZorevCart.media(id) : null; }

  function qtyOf(c, pid) {
    return (c.items || []).reduce(function (n, i) { return n + (i.product_id === pid ? i.quantity : 0); }, 0);
  }
  var lastKey = null, chosen = {};
  function hide() { lastKey = null; slot.hidden = true; slot.innerHTML = ''; slot.removeAttribute('data-state'); }
  function put(key, state, html) {
    if (key === lastKey && !slot.hidden) return;
    lastKey = key;
    slot.hidden = false;
    slot.setAttribute('data-state', state);
    slot.innerHTML = html;
  }

  function confirmRow(amount) {
    put('applied|' + amount, 'applied',
      '<p class="cd__pairok" tabindex="-1" data-cd-pairfocus>' +
        '<span class="cd__pairokic" aria-hidden="true">' + ICON_CHECK + '</span>' +
        '<span><strong>' + esc(cfg.name) + '</strong> &middot; You&rsquo;re saving ' + esc(short(amount)) + '</span>' +
      '</p>');
  }

  function note() {
    put('note', 'note',
      '<p class="cd__pairnote"><strong>Pair saving not applied.</strong> ' +
        'It comes off once per order, and not while the bag has three or more ' + esc(cfg.b.short) +
        ' with fewer ' + esc(cfg.a.short) + '.</p>');
  }

  function thumbSrc(p, vid) {
    var m = media(vid);
    return (m && m.src) || p.image || '';
  }

  function offer(which, haveOther, local) {
    var p = cfg[which];
    var avail = (p.variants || []).filter(function (x) { return x.available; });
    if (!avail.length) { hide(); return; }
    var vid = String(chosen[which] || avail[0].id);
    if (!avail.some(function (x) { return String(x.id) === vid; })) vid = String(avail[0].id);
    var other = cfg[which === 'a' ? 'b' : 'a'];
    var head = local ? 'Add ' + esc(p.short) + ' and save ' + esc(short(cfg.save))
                     : 'Add ' + esc(p.short) + ' to make it a pair';
    var line = !local ? 'The pair saving comes off in your bag, once per order.'
      : haveOther > 1
        ? esc(p.short) + ' for ' + esc(short(p.price - cfg.save)) + ' with your ' + esc(other.short)
        : esc(short(cfg.a.price + cfg.b.price - cfg.save)) + ' together';
    var pick = '';
    if (avail.length > 1) {
      pick = '<label class="cd__pairpick"><span class="cd__picklabel">' + esc(p.short) + ' option</span>' +
        '<select data-cd-pairvar data-cd-which="' + which + '">' + avail.map(function (x) {
          var m = media(x.id);
          var name = (m && m.label) || x.title;
          return '<option value="' + x.id + '"' + (String(x.id) === vid ? ' selected' : '') + '>' + esc(name) + '</option>';
        }).join('') + '</select></label>';
    }
    var src = thumbSrc(p, vid);
    put('offer|' + which + '|' + (haveOther > 1 ? 'n' : '1') + '|' + local, 'offer',
      '<div class="cd__paircard">' +
        (src ? '<span class="cd__pairimg zv-studio" aria-hidden="true"><img src="' + esc(src) + '" alt="" width="56" height="56" loading="lazy" decoding="async" data-cd-pairimg data-cd-which="' + which + '"></span>' : '<span class="cd__pairimg zv-studio" aria-hidden="true"></span>') +
        '<div class="cd__pairtxt">' +
          '<p class="cd__pairk">Complete your ' + esc(bare) + '</p>' +
          '<p class="cd__pairh">' + head + '</p>' +
          '<p class="cd__pairl">' + line + '</p>' +
        '</div>' +
        '<div class="cd__pairact">' + pick +
          '<button type="button" class="cd__pairbtn" data-cd-pairadd="' + vid + '">Add ' + esc(p.short) + '</button>' +
        '</div>' +
        '<p class="cd__pairerr" role="alert" data-cd-pairerr hidden></p>' +
      '</div>');
  }

  function render(c) {
    if (!c || !c.item_count) { hide(); return; }
    var g = qtyOf(c, cfg.a.id), h = qtyOf(c, cfg.b.id);
    var list = window.ZorevDiscountsOf ? window.ZorevDiscountsOf(c) : [];
    var hit = list.filter(function (d) { return d.title === cfg.title; })[0];
    if (hit) { confirmRow(hit.amount); return; }
    var local = !shopCur || !c.currency || c.currency === shopCur;
    if (g >= 1 && h === 0 && applies(g, 1)) { offer('b', g, local); return; }
    if (h >= 1 && g === 0 && applies(1, h)) { offer('a', h, local); return; }
    if (g >= 1 && h >= 1 && !applies(g, h)) { note(); return; }
    hide();
  }

  document.addEventListener('cart:painted', function (e) { render(e.detail); });

  slot.addEventListener('change', function (e) {
    var sel = e.target.closest('[data-cd-pairvar]');
    if (!sel) return;
    var which = sel.getAttribute('data-cd-which');
    chosen[which] = sel.value;
    var btn = slot.querySelector('[data-cd-pairadd]');
    if (btn) btn.setAttribute('data-cd-pairadd', sel.value);
    var img = slot.querySelector('[data-cd-pairimg]');
    var src = cfg[which] ? thumbSrc(cfg[which], sel.value) : '';
    if (img && src) img.src = src;
  });

  slot.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-cd-pairadd]');
    if (!btn || btn.getAttribute('aria-busy') === 'true') return;
    var label = btn.textContent;
    var errEl = slot.querySelector('[data-cd-pairerr]');
    if (errEl) { errEl.hidden = true; errEl.textContent = ''; }
    /* aria-disabled, not disabled: a disabled button drops focus to <body>,
       outside the dialog. */
    btn.setAttribute('aria-busy', 'true');
    btn.setAttribute('aria-disabled', 'true');
    btn.textContent = 'Adding…';
    lastKey = null;
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ items: [{ id: Number(btn.getAttribute('data-cd-pairadd')), quantity: 1 }] })
    })
      .then(function (r) {
        if (r.ok) return r.json();
        return r.json().catch(function () { return null; }).then(function (j) {
          var e2 = new Error((j && (j.description || j.message)) || ''); e2.shop = true; throw e2;
        });
      })
      .then(function () {
        if (!window.ZorevCart) { document.dispatchEvent(new CustomEvent('cart:updated')); return; }
        window.ZorevCart.say('Added to your bag.');
        return window.ZorevCart.fetch().then(function () {
          /* The button has been repainted away; keep focus in the dialog. */
          var a = document.activeElement;
          if (window.ZorevCart.isOpen() && (!a || a === document.body || !drawer.contains(a))) {
            var target = slot.querySelector('[data-cd-pairfocus]') || drawer.querySelector('.cd__panel');
            if (target) target.focus();
          }
        });
      })
      .catch(function (err) {
        btn.removeAttribute('aria-busy'); btn.removeAttribute('aria-disabled'); btn.textContent = label;
        var msg = (err && err.shop && err.message) || 'That could not be added. Please try again.';
        if (errEl) { errEl.textContent = msg; errEl.hidden = false; }
      });
  });
})();
</script>

<style>
/* .visually-hidden lives in zorev-tokens.css. */

/* ---------------------------------------------------------------- Cart drawer */
html.cd-locked{overflow:hidden}

/* Above the header (60) via the token scale rather than a guessed number. */
.cd{position:fixed;inset:0;z-index:var(--zv-z-toast)}
.cd[hidden]{display:none}
/* The night raw stays dark in both editions; the dim is its opacity, so the
   scrim needs no colour literal. */
.cd__scrim{
  position:absolute;inset:0;
  background:var(--zv-night);
  backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);
  opacity:0;transition:opacity var(--zv-d-drawer) var(--zv-ease);
}
.cd.is-open .cd__scrim{opacity:.5}

.cd__panel{
  position:absolute;top:0;right:0;height:100%;
  width:min(440px,100%);
  display:flex;flex-direction:column;
  background:var(--zv-bg);
  color:var(--zv-text);
  border-left:1px solid var(--zv-hairline);
  box-shadow:var(--zv-sh-4);
  transform:translateX(100%);
  transition:transform var(--zv-d-drawer) var(--zv-ease-drawer);
  outline:none;
  /* the notch and the home indicator both live inside this panel */
  padding-top:env(safe-area-inset-top, 0px);
}
.cd.is-open .cd__panel{transform:none}

.cd__head{
  display:flex;align-items:center;justify-content:space-between;gap:var(--zv-4);
  padding:var(--zv-4) var(--zv-gutter);
  border-bottom:1px solid var(--zv-hairline);flex:0 0 auto;
}
.cd__title{
  font-family:var(--zv-sans);font-size:var(--zv-t-micro);font-weight:600;
  letter-spacing:var(--zv-tr-caps);text-transform:uppercase;
  color:var(--zv-text);margin:0;
}
.cd__x{
  width:44px;height:44px;min-width:44px;
  display:grid;place-items:center;border-radius:50%;cursor:pointer;
  background:transparent;border:1px solid var(--zv-line-input);color:var(--zv-text-2);
  transition:color var(--zv-d-hover) var(--zv-ease),
             border-color var(--zv-d-hover) var(--zv-ease),
             background var(--zv-d-hover) var(--zv-ease);
}
@media (hover:hover) and (pointer:fine){
  .cd__x:hover{color:var(--zv-text);border-color:var(--zv-accent);background:var(--zv-bg-sunken)}
}

.cd__scroll{
  flex:1 1 auto;min-height:0;overflow-y:auto;-webkit-overflow-scrolling:touch;
  overscroll-behavior:contain;
}
.cd__err{margin:var(--zv-3) var(--zv-gutter) 0;padding:var(--zv-2) var(--zv-3);max-width:none;
  border-radius:var(--zv-r-sm);background:var(--zv-bg-sunken);color:var(--zv-text);
  font-size:var(--zv-t-fine);box-shadow:inset 3px 0 0 var(--zv-accent)}
.cd__err[hidden]{display:none}
.cd__body{padding:0 var(--zv-gutter)}
.cd__body[aria-busy="true"]{opacity:.55;pointer-events:none;transition:opacity var(--zv-d-hover) var(--zv-ease)}
.cd__loading{padding-block:var(--zv-6)}

/* ---- empty bag ---- */
.cd__empty{padding-block:var(--zv-8) var(--zv-6);display:grid;gap:var(--zv-3);justify-items:start}
.cd__emptyh{margin:0;font-family:var(--zv-serif);font-size:var(--zv-t-h4);line-height:var(--zv-lh-snug);
  color:var(--zv-text);outline:none}
.cd__emptyp{margin:0;max-width:34ch;font-size:var(--zv-t-sm);line-height:var(--zv-lh-body);color:var(--zv-text-2)}
.cd__emptyact{display:flex;flex-wrap:wrap;gap:var(--zv-2);margin-top:var(--zv-3)}

/* ---- lines ---- */
.cd__lines{list-style:none;margin:0;padding:0}
.cd__line{
  display:grid;grid-template-columns:72px 1fr auto;gap:var(--zv-3);align-items:start;
  padding:var(--zv-4) 0;border-bottom:1px solid var(--zv-hairline);
}
/* Every picture stands on the studio plate (.zv-studio, zorev-tokens.css):
   supplier white dissolves into it, packshots read as one set. */
.cd__thumb{
  display:block;width:72px;height:72px;border-radius:var(--zv-r-sm);
  box-shadow:inset 0 0 0 1px var(--zv-hairline);
  --zv-studio-pad:7%;
}
.cd__thumb--empty{background:var(--zv-bg-sunken)}
.cd__lineinfo{min-width:0}
/* min-height 44, not just the text box: this is the link back to the
   product from the bag. */
.cd__name{
  display:flex;align-items:center;min-height:44px;
  font-family:var(--zv-serif);font-size:var(--zv-t-body);
  line-height:var(--zv-lh-snug);color:var(--zv-text);margin-bottom:var(--zv-1);
  text-decoration:none;text-wrap:balance;
}
@media (hover:hover) and (pointer:fine){
  .cd__name:hover{text-decoration:underline;text-underline-offset:3px}
}
.cd__var{margin:0 0 var(--zv-2);color:var(--zv-text-2);font-size:var(--zv-t-fine)}

.cd__qty{display:inline-flex;align-items:center;
  border:1px solid var(--zv-line-input);border-radius:var(--zv-r-pill);overflow:hidden}
.cd__step{
  width:44px;height:44px;min-width:44px;
  display:grid;place-items:center;background:none;border:0;cursor:pointer;
  color:var(--zv-text-2);font-size:1.05rem;line-height:1;
  transition:color var(--zv-d-hover) var(--zv-ease),
             background var(--zv-d-hover) var(--zv-ease);
}
/* Inside the pill the ring is drawn inset, or overflow:hidden clips it. */
.cd__step:focus-visible{outline:2px solid var(--zv-focus);outline-offset:-3px;border-radius:var(--zv-r-pill)}
@media (hover:hover) and (pointer:fine){
  .cd__step:hover{color:var(--zv-text);background:var(--zv-bg-sunken)}
}
.cd__n{min-width:2ch;text-align:center;font-variant-numeric:tabular-nums;
  font-size:var(--zv-t-sm);color:var(--zv-text)}

.cd__lineend{display:grid;gap:var(--zv-2);justify-items:end;text-align:right}
.cd__lp{color:var(--zv-text);font-size:var(--zv-t-body);font-weight:600;
  font-variant-numeric:tabular-nums;white-space:nowrap}
.cd__rm{
  background:none;border:0;padding:0;cursor:pointer;
  font-family:var(--zv-sans);font-size:var(--zv-t-fine);color:var(--zv-text-3);
  text-decoration:underline;text-underline-offset:3px;
  /* The 44pt target is met by the invisible box, not the text. */
  min-height:44px;display:inline-flex;align-items:center;
}
@media (hover:hover) and (pointer:fine){ .cd__rm:hover{color:var(--zv-text)} }

.cd__foot{
  flex:0 0 auto;
  padding:var(--zv-4) var(--zv-gutter) calc(var(--zv-4) + env(safe-area-inset-bottom));
  border-top:1px solid var(--zv-hairline);
  background:var(--zv-bg-sunken);
  /* --zv-muted is 5.3:1 on stone; moss-strong reads a step firmer on the
     one band of the drawer that carries the total. */
  --zv-text-3:var(--zv-moss-strong);
  --text-3:var(--zv-moss-strong);
}
.cd__foot[hidden]{display:none}
.cd__row{display:flex;justify-content:space-between;align-items:baseline;
  gap:var(--zv-4);margin-bottom:var(--zv-1)}
.cd__rowk{font-family:var(--zv-sans);font-size:var(--zv-t-micro);font-weight:600;
  letter-spacing:var(--zv-tr-caps);text-transform:uppercase;color:var(--zv-text-3)}
.cd__rowv{font-family:var(--zv-sans);font-size:var(--zv-t-h4);font-weight:600;
  color:var(--zv-text);font-variant-numeric:tabular-nums}
.cd__rowv s{font-weight:400;margin-right:var(--zv-1)}
.cd__note{margin:0 0 var(--zv-4);color:var(--zv-text-3)}
.cd__link{display:inline-flex;align-items:center;min-height:44px;margin-top:var(--zv-2);
  color:var(--zv-text-2);text-decoration:underline;text-underline-offset:3px}

/* ---- itemised savings: Shopify's own discount titles and amounts ---- */
.cd__savings{margin:0 0 var(--zv-3);padding-bottom:var(--zv-3);border-bottom:1px solid var(--zv-hairline)}
.cd__disc{list-style:none;margin:0;padding:0;display:grid;gap:var(--zv-1)}
.cd__disc li{display:flex;justify-content:space-between;align-items:baseline;gap:var(--zv-3);
  font-size:var(--zv-t-fine);color:var(--zv-text-2)}
.cd__disct{min-width:0}
.cd__disca{font-variant-numeric:tabular-nums;color:var(--zv-accent);font-weight:600;white-space:nowrap}
.cd__saved{display:flex;justify-content:space-between;margin:var(--zv-2) 0 0;max-width:none;
  font-family:var(--zv-sans);font-size:var(--zv-t-sm);font-weight:600;color:var(--zv-accent);
  font-variant-numeric:tabular-nums}

/* ---- the pair offer ---- */
