{%- comment -%}
  Social cards + JSON-LD. Product schema carries price, availability and
  currency, which is what earns the rich result in search.

  The sitelinks search target needs literal braces around
  search_term_string. Written inline they break Liquid's lexer, so the
  braces are assigned separately and captured.
{%- endcomment -%}

{%- liquid
  assign og_title = seo_title | default: page_title
  assign og_desc = seo_desc | default: page_description | default: shop.description | default: shop.name
  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
    assign og_img = product.featured_media.preview_image
  elsif request.page_type == 'article'
    assign og_type = 'article'
    assign og_img = article.image
  elsif request.page_type == 'collection'
    assign og_img = collection.featured_image
  endif
  unless og_img
    assign og_img = settings.social_image
  endunless
-%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_desc | strip_html | truncate: 200 | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
{%- if og_img -%}
  <meta property="og:image" content="https:{{ og_img | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="https:{{ og_img | image_url: width: 1200 }}">
{%- else -%}
  <meta name="twitter:card" content="summary">
{%- endif -%}
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_desc | strip_html | truncate: 200 | escape }}">

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | strip_html | json }},
    "description": {{ product.description | strip_html | truncate: 400 | json }},
    "sku": {{ product.selected_or_first_available_variant.sku | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    {%- if product.featured_media -%}
    "image": [{% for m in product.media limit: 5 %}{{ m.preview_image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
    {%- endif -%}
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "lowPrice": {{ product.price_min | divided_by: 100.0 | json }},
      "highPrice": {{ product.price_max | divided_by: 100.0 | json }},
      "offerCount": {{ product.variants.size }},
      "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
      "url": {{ product.url | prepend: shop.url | json }}
    }
  }
  </script>
{%- elsif request.page_type == 'index' -%}
  {%- assign brace_open = '{' -%}
  {%- assign brace_close = '}' -%}
  {%- capture search_target -%}{{ shop.url }}/search?q={{ brace_open }}search_term_string{{ brace_close }}{%- endcapture -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "description": {{ og_desc | strip_html | json }}
    {%- if settings.support_email != blank -%},
    "contactPoint": { "@type": "ContactPoint", "email": {{ settings.support_email | json }}, "contactType": "customer service" }
    {%- endif -%}
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "potentialAction": {
      "@type": "SearchAction",
      "target": {{ search_target | json }},
      "query-input": "required name=search_term_string"
    }
  }
  </script>
{%- endif -%}

{%- if request.page_type == 'product' or request.page_type == 'collection' or request.page_type == 'article' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} },
      { "@type": "ListItem", "position": 2, "name": {{ page_title | strip_html | json }}, "item": {{ canonical_url | json }} }
    ]
  }
  </script>
{%- endif -%}
