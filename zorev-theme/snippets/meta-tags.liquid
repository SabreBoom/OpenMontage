{%- comment -%}
  Social cards + JSON-LD. Product schema carries one Offer per option with
  its own price, availability, condition and URL: Google's merchant listings
  (price and stock in results, the Shopping tab) need Offer, not the
  AggregateOffer this used to send. Breadcrumbs use the page's own name,
  not its SEO title (which ends in "| ZOREV").

  The sitelinks search target needs literal braces around
  search_term_string. Written inline they break Liquid's lexer, so the
  braces are assigned separately and captured.

  Social image (V15): a product page shares its studio packshot (the
  maker's own photograph for the selected option, Theme settings > Studio
  images) when the studio set is on, else its featured image. Pages with
  no image of their own share Theme settings > Brand > Social image, cut
  to 1200x630 from the centre. Descriptions use escape_once: Shopify's
  page_description arrives already escaped.
{%- endcomment -%}

{%- liquid
  assign og_title = seo_title | default: page_title
  assign og_desc = seo_desc | default: page_description | default: shop.description | default: settings.seo_home_description | default: shop.name
  assign og_type = 'website'
  assign og_studio = false
  if request.page_type == 'product'
    assign og_type = 'product'
    if settings.studio_mode == 'on'
      assign og_vid = product.selected_or_first_available_variant.id | append: ''
      for n in (1..10)
        assign key_v = 'studio_' | append: n | append: '_variant'
        assign key_i = 'studio_' | append: n | append: '_image'
        assign slot_v = settings[key_v] | append: '' | strip
        if slot_v == og_vid and settings[key_i] != blank
          assign og_img = settings[key_i]
          assign og_studio = true
          break
        endif
      endfor
    endif
    unless og_img
      assign og_img = product.featured_media.preview_image
    endunless
  elsif request.page_type == 'article'
    assign og_type = 'article'
    assign og_img = article.image
  elsif request.page_type == 'collection'
    assign og_img = collection.featured_image
  endif
  unless og_img
    assign og_img = settings.social_image
  endunless

  comment
    Never ask for more pixels than the file has. A wide image is cut to the
    1200x630 card shape; a square or tall one is sent whole.
  endcomment
  if og_img
    assign og_w = og_img.width | default: 1200
    assign og_h = og_img.height | default: 1200
    assign og_crop = false
    if og_w >= 1200 and og_h >= 630
      assign og_ratio = og_w | times: 100 | divided_by: og_h
      if og_ratio >= 150
        assign og_crop = true
      endif
    endif
    if og_crop
      assign og_url = og_img | image_url: width: 1200, height: 630, crop: 'center'
      assign og_w = 1200
      assign og_h = 630
    else
      if og_w > 1200
        assign og_h = og_h | times: 1200 | divided_by: og_w
        assign og_w = 1200
      endif
      assign og_url = og_img | image_url: width: og_w
    endif
    assign og_alt = og_img.alt
    if og_alt == blank or og_studio
      assign og_alt = og_title
    endif
  endif
-%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_desc | strip_html | truncate: 200 | escape_once }}">
<meta property="og:url" content="{{ canonical_url }}">
{%- if og_img -%}
  <meta property="og:image" content="https:{{ og_url }}">
  <meta property="og:image:secure_url" content="https:{{ og_url }}">
  <meta property="og:image:width" content="{{ og_w }}">
  <meta property="og:image:height" content="{{ og_h }}">
  <meta property="og:image:alt" content="{{ og_alt | strip_html | escape_once }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="https:{{ og_url }}">
  <meta name="twitter:image:alt" content="{{ og_alt | strip_html | escape_once }}">
{%- else -%}
  <meta name="twitter:card" content="summary">
{%- endif -%}
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_desc | strip_html | truncate: 200 | escape_once }}">

{%- if request.page_type == 'product' -%}
  {%- assign ld_sku = product.selected_or_first_available_variant.sku -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | strip_html | json }},
    "url": {{ product.url | prepend: shop.url | json }},
    "description": {{ product.description | strip_html | strip | truncate: 400 | json }},
    {%- if ld_sku != blank -%}
    "sku": {{ ld_sku | json }},
    {%- endif -%}
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    {%- liquid
      comment
        Images: the studio packshots of this product's options when the
        studio set is on (the makers' own photographs), else its media.
      endcomment
      assign ld_imgs = ''
      if settings.studio_mode == 'on'
        assign ld_ids = ''
        for v in product.variants
          assign ld_ids = ld_ids | append: '|' | append: v.id | append: '|'
        endfor
        for n in (1..10)
          assign key_v = 'studio_' | append: n | append: '_variant'
          assign key_i = 'studio_' | append: n | append: '_image'
          assign slot_v = settings[key_v] | append: '' | strip
          assign slot_k = '|' | append: slot_v | append: '|'
          if slot_v != blank and ld_ids contains slot_k and settings[key_i] != blank
            assign ld_w = settings[key_i].width | default: 1200
            if ld_w > 1200
              assign ld_w = 1200
            endif
            assign ld_u = settings[key_i] | image_url: width: ld_w | prepend: 'https:' | json
            if ld_imgs != ''
              assign ld_imgs = ld_imgs | append: ','
            endif
            assign ld_imgs = ld_imgs | append: ld_u
          endif
        endfor
      endif
      if ld_imgs == '' and product.featured_media
        for m in product.media limit: 5
          assign ld_u = m.preview_image | image_url: width: 1200 | prepend: 'https:' | json
          if ld_imgs != ''
            assign ld_imgs = ld_imgs | append: ','
          endif
          assign ld_imgs = ld_imgs | append: ld_u
        endfor
      endif
    -%}
    {%- if ld_imgs != '' -%}
    "image": [{{ ld_imgs }}],
    {%- endif -%}
    "offers": [
      {%- for v in product.variants -%}
      {
        "@type": "Offer",
        {%- if product.variants.size > 1 -%}"name": {{ v.title | json }},{%- endif -%}
        {%- if v.sku != blank -%}"sku": {{ v.sku | json }},{%- endif -%}
        "price": {{ v.price | divided_by: 100.0 | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
        "itemCondition": "https://schema.org/NewCondition",
        "url": {{ product.url | append: '?variant=' | append: v.id | prepend: shop.url | json }}
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
{%- elsif request.page_type == 'index' -%}
  {%- assign brace_open = '{' -%}
  {%- assign brace_close = '}' -%}
  {%- capture search_target -%}{{ shop.url }}/search?q={{ brace_open }}search_term_string{{ brace_close }}{%- endcapture -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "description": {{ og_desc | strip_html | json }}
    {%- if settings.support_email != blank -%},
    "contactPoint": { "@type": "ContactPoint", "email": {{ settings.support_email | json }}, "contactType": "customer service" }
    {%- endif -%}
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "potentialAction": {
      "@type": "SearchAction",
      "target": {{ search_target | json }},
      "query-input": "required name=search_term_string"
    }
  }
  </script>
{%- endif -%}

{%- if request.page_type == 'product' or request.page_type == 'collection' or request.page_type == 'article' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} },
      {%- liquid
        assign crumb = page_title
        if request.page_type == 'product'
          assign crumb = product.title
        elsif request.page_type == 'collection'
          assign crumb = collection.title
        elsif request.page_type == 'article'
          assign crumb = article.title
        endif
      -%}
      { "@type": "ListItem", "position": 2, "name": {{ crumb | strip_html | json }}, "item": {{ canonical_url | json }} }
    ]
  }
  </script>
{%- endif -%}
