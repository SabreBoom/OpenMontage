{%- comment -%}
  Line icons, 20px on a 24 grid, 1.5 stroke, currentColor.
  Decorative by default (aria-hidden) — every use sits next to text that
  already says what the icon means.
  Usage: {% render 'zicon', name: 'truck' %}
{%- endcomment -%}
<svg class="zicon zicon--{{ name }}" width="20" height="20" viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'truck' -%}<path d="M3 6.5h11v9H3z"/><path d="M14 9.5h3.6l2.9 3v3H14z"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17" cy="17.5" r="1.6"/>
    {%- when 'lock' -%}<rect x="5" y="10.5" width="14" height="9.5" rx="2"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"/>
    {%- when 'shield' -%}<path d="M12 3.5l7 2.8v5.3c0 4.3-3 7.6-7 8.9-4-1.3-7-4.6-7-8.9V6.3z"/><path d="M9 12l2.1 2.1L15.2 10"/>
    {%- when 'chat' -%}<path d="M4.5 5.5h15v10h-8.2L7 19v-3.5H4.5z"/>
    {%- when 'return' -%}<path d="M9 7.5L5.5 11 9 14.5"/><path d="M5.5 11H15a3.5 3.5 0 0 1 0 7h-2"/>
    {%- when 'check' -%}<path d="M5 12.5l4.2 4.2L19 7"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'box' -%}<path d="M4 8l8-4 8 4v8.5l-8 4-8-4z"/><path d="M4 8l8 4 8-4M12 12v8.5"/>
    {%- when 'mail' -%}<rect x="3.5" y="6" width="17" height="12" rx="1.5"/><path d="M4 7l8 6 8-6"/>
    {%- when 'star' -%}<path d="M12 4.2l2.4 4.9 5.4.8-3.9 3.8.9 5.3L12 16.5 7.2 19l.9-5.3-3.9-3.8 5.4-.8z"/>
  {%- endcase -%}
</svg>
