{%- comment -%}
  Product showcase — the homepage's "here is what we sell".

  Two editorial panels rather than two stock product cards. Each product
  is the maker's own packshot (Theme settings > Studio images, through
  snippets/studio-image) standing on the same warm stone plate, so the
  line-up reads as one studio shoot rather than two supplier listings. With
  studio images off it falls back to the product's own photograph.

  Then: the type, the maker's name, one plain sentence, optional physical
  facts, the price and the multi-buy line read from the product's own offer
  data (zorev.offer).

  One way into each product (WCAG 2.4.4 / fewer repeated stops): the
  "Shop GODA" button is the card's link for keyboards and screen readers;
  the plate is a second, pointer-only route to the same page
  (tabindex -1, aria-hidden), so a tap anywhere on the picture works too.
  Desktop hover grows the packshot a touch; touch screens press it.

  The action respects variants: a single-variant product can also add
  directly, through a plain form that zorev.js turns into an Ajax add.

  Asset slot (visual asset brief, S1 / S2). Each product block takes an
  optional scene photograph and film of the real product in use. Set, it
  fills the same square as the plate. Nothing is ever shown that is not
  the real product.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="zsc{% if s.raised %} band--raised{% endif %}" id="line" aria-labelledby="zsc-h-{{ section.id }}">
  <div class="zv-wrap">
    <header class="zsc__head" data-zv-reveal>
      {%- if s.eyebrow != blank -%}<span class="zv-eyebrow">{{ s.eyebrow | escape }}</span>{%- endif -%}
      <h2 class="zv-h2" id="zsc-h-{{ section.id }}">{{ s.heading }}</h2>
      {%- if s.body != blank -%}<div class="zv-lead zsc__lead">{{ s.body }}</div>{%- endif -%}
    </header>

    <div class="zsc__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign offer = p.metafields.zorev.offer.value
          assign short = p.vendor | upcase
          assign dv = p.selected_or_first_available_variant
          assign fid = 'zsc-add-' | append: section.id | append: '-' | append: forloop.index
          assign sidx = block.settings.studio_index | default: 1 | minus: 1
          assign has_scene = false
          if block.settings.scene != blank or block.settings.scene_video != blank
            assign has_scene = true
          endif
        -%}
        {%- if p != blank and p.title != blank -%}
        <article class="zsc__item" data-zv-reveal {{ block.shopify_attributes }}>
          {%- if has_scene -%}
            {%- comment -%}
              The picture is a link like the plate, but the film's pause
              button must stay reachable, so the link is a sibling layer
              under the media rather than a wrapper around it.
            {%- endcomment -%}
            <div class="zsc__frame zsc__frame--scene">
              {% render 'zv-media', media: block.settings.scene_video, image: block.settings.scene, sizes: '(min-width: 1240px) 560px, (min-width: 760px) 44vw, calc(50vw - 26px)', alt: block.settings.scene_alt %}
              <a class="zsc__cover" href="{{ p.url }}" tabindex="-1" aria-hidden="true"></a>
            </div>
          {%- else -%}
            <a class="zsc__frame zsc__plate zv-studio zv-studio--floor" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
              {% render 'studio-image', product: p, variant: dv, index: sidx, widths: '240,360,480,640,800,1000', sizes: '(min-width: 1240px) 560px, (min-width: 760px) 44vw, calc(50vw - 26px)', class: 'zsc__img', loading: 'lazy', fetchpriority: 'auto', alt: '' %}
            </a>
          {%- endif -%}

          <div class="zsc__body">
            {%- if p.type != blank -%}<p class="zsc__k">{{ p.type | escape }}</p>{%- endif -%}
            {%- comment -%}
              The maker's name as the product's name — GODA, HOYGI — the way
              the pair and the price ladders already say it. The full listing
              title stays on the product page, and in the button for a
              screen reader.
            {%- endcomment -%}
            <h3 class="zsc__name">{{ short | escape }}</h3>
            {%- if block.settings.line != blank -%}<p class="zsc__line">{{ block.settings.line | escape }}</p>{%- endif -%}
            {%- if block.settings.facts != blank -%}<div class="zsc__facts">{{ block.settings.facts }}</div>{%- endif -%}

            <div class="zsc__buy">
              <p class="zsc__price">
                <span class="zsc__from">{{ p.price | money_without_trailing_zeros }}</span>
                {%- if offer.breaks.size > 0 -%}
                  <span class="zsc__multi">
                    {%- for t in offer.breaks -%}
                      {%- assign tot = p.price | times: t.qty | minus: t.save -%}
                      {{ t.qty }} for {{ tot | money_without_trailing_zeros }}{% unless forloop.last %} &middot; {% endunless %}
                    {%- endfor -%}
                  </span>
                {%- endif -%}
              </p>

              <div class="zsc__act">
                <a class="zv-btn zsc__shop" href="{{ p.url }}">Shop {{ short | escape }}<span class="visually-hidden"> &mdash; {{ p.title | escape }}</span></a>
                {%- if p.has_only_default_variant and dv.available -%}
                  {%- form 'product', p, id: fid, class: 'zsc__form' -%}
                    <input type="hidden" name="id" value="{{ dv.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button class="zv-btn zv-btn--ghost zsc__add" type="submit" data-add>Add to bag</button>
                  {%- endform -%}
                {%- endif -%}
              </div>
            </div>
          </div>
        </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <style>
    .zsc{padding-block:var(--zv-section);background:var(--zv-bg);color:var(--zv-text);scroll-margin-top:72px}
    .zsc.band--raised{background:var(--zv-bg-sunken)}
    .zsc__head{max-width:40rem;margin-bottom:clamp(28px,4vw,56px)}
    .zsc__head .zv-h2{margin:0 0 var(--zv-3)}
    .zsc__lead > :last-child{margin-bottom:0}
    .zsc__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px 12px}
    @media(min-width:760px){.zsc__grid{gap:clamp(24px,3vw,48px)}}

    /* The two cards stretch to the same height (grid row); the body fills
       what is left under the plate and the price + button sit at its foot,
       so a description that wraps one line more never staggers the row. */
    .zsc__item{display:grid;grid-template-rows:auto 1fr;gap:14px}
    @media(min-width:760px){.zsc__item{gap:var(--zv-5)}}
    /* Square at every width: the packshot contained on the warm stone plate
       (.zv-studio, zorev-tokens.css), never cropped. */
    .zsc__frame{position:relative;display:block;aspect-ratio:1 / 1;border-radius:var(--zv-r-lg);overflow:hidden;isolation:isolate;
      -webkit-tap-highlight-color:transparent}
    .zsc__plate{background:var(--zv-plate,var(--zv-bg-sunken));--zv-studio-pad:9%}
    .zsc__img{display:block;width:100%;height:100%;padding:var(--zv-studio-pad,9%);object-fit:contain;mix-blend-mode:multiply;
      transition:transform var(--zv-d-zoom,600ms) var(--zv-ease)}
    .zsc__frame--scene .zv-media{position:absolute;inset:0}
    .zsc__frame--scene img{transition:transform var(--zv-d-zoom,600ms) var(--zv-ease)}
    /* the click layer sits under the film's pause button (z-index 3) */
    .zsc__cover{position:absolute;inset:0;z-index:2}
    @media (hover:hover) and (pointer:fine){
      .zsc__item:hover .zsc__img,
      .zsc__item:hover .zsc__frame--scene img{transform:scale(var(--zv-zoom,1.02))}
    }
    @media (hover:none){
      .zsc__frame{transition:transform var(--zv-d-tap,90ms) var(--zv-ease)}
      .zsc__frame:active{transform:scale(var(--zv-press,.985))}
    }

    .zsc__body{display:flex;flex-direction:column;align-items:stretch;gap:var(--zv-2);min-width:0}
    .zsc__k{margin:0;font-size:var(--zv-t-micro);font-weight:600;letter-spacing:var(--zv-tr-caps);
      text-transform:uppercase;color:var(--zv-forest)}
    .zsc__name{margin:0;font-family:var(--zv-serif);font-weight:400;font-size:clamp(1.5rem,1.2rem + 1.4vw,2.75rem);
      line-height:1.05;letter-spacing:var(--zv-tr-tight);color:var(--zv-text)}
    .zsc__line{margin:0;color:var(--zv-text-2);max-width:40ch;font-size:var(--zv-t-sm);line-height:1.5}
    @media(min-width:760px){.zsc__line{font-size:var(--zv-t-body);line-height:var(--zv-lh-body)}}
    /* Physical facts as a short ruled list, not a badge row. */
    .zsc__facts ul{list-style:none;margin:var(--zv-2) 0 0;padding:0;display:grid}
    .zsc__facts li{padding:9px 0;border-top:1px solid var(--zv-line);font-size:var(--zv-t-sm);color:var(--zv-text-2)}
    .zsc__facts li:last-child{border-bottom:1px solid var(--zv-line)}
    .zsc__facts strong{color:var(--zv-text);font-weight:600}
    .zsc__facts p{margin:0;font-size:var(--zv-t-sm);color:var(--zv-text-2)}
    .zsc__buy{display:grid;gap:var(--zv-4);margin-top:auto;padding-top:var(--zv-2)}
    .zsc__price{display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 10px;margin:0;max-width:none;
      font-variant-numeric:tabular-nums}
    @media(min-width:760px){.zsc__price{gap:4px 14px}}
    .zsc__from{font-size:var(--zv-t-h4);font-weight:600;color:var(--zv-text);letter-spacing:-0.01em}
    .zsc__multi{font-size:var(--zv-t-fine);color:var(--zv-forest);font-weight:600}
    @media(min-width:760px){.zsc__multi{font-size:var(--zv-t-sm)}}
    .zsc__act{display:flex;flex-direction:column;gap:var(--zv-3)}
    .zsc__act .zv-btn{width:100%;justify-content:center;padding-inline:var(--zv-3)}
    .zsc__form{display:none}
    @media(min-width:760px){
      .zsc__act{flex-direction:row;flex-wrap:wrap}
      .zsc__act .zv-btn{width:auto;padding-inline:var(--zv-5)}
      .zsc__form{display:flex}
    }
    @media(prefers-reduced-motion:reduce){ .zsc__item:hover .zsc__img,.zsc__item:hover .zsc__frame--scene img,.zsc__frame:active{transform:none} }
  </style>
</section>
{% schema %}
{
  "name": "Product showcase",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The line" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Two essentials." },
    { "type": "richtext", "id": "body", "label": "Intro" },
    { "type": "checkbox", "id": "raised", "label": "Raised background", "default": false }
  ],
  "blocks": [
    { "type": "product", "name": "Product", "limit": 4,
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "range", "id": "studio_index", "label": "Studio image", "min": 1, "max": 3, "step": 1, "default": 1,
          "info": "Which of this product's studio images (Theme settings > Studio images) stands on the plate. Pick the one shot like the others: the product with its box, on a plain ground." },
        { "type": "text", "id": "line", "label": "One-line description",
          "info": "What it physically is. No claims the product page can't back up." },
        { "type": "richtext", "id": "facts", "label": "Physical facts",
          "info": "A short bulleted list: size, form, options, how it is used. Leave the maker's own claims on the product page, labelled as theirs." },
        { "type": "header", "content": "Scene (optional)" },
        { "type": "paragraph", "content": "Empty: the product's studio packshot on the stone plate. Add a real photograph of this product in use (visual asset brief S1 for GODA, S2 for HOYGI) and it fills the same square." },
        { "type": "image_picker", "id": "scene", "label": "Scene photograph", "info": "Square 1:1, at least 2000 × 2000 px. Set the focal point in Content > Files." },
        { "type": "video", "id": "scene_video", "label": "Scene film (optional)", "info": "Square, 5 to 8 seconds, silent, loops cleanly. Uses the photograph above as its poster." },
        { "type": "text", "id": "scene_alt", "label": "Scene description", "info": "What is in the picture, for screen readers." }
      ] }
  ],
  "presets": [{ "name": "Product showcase", "blocks": [{ "type": "product" }, { "type": "product" }] }]
}
{% endschema %}
