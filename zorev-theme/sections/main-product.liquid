    /* ---- sticky bar (phones) ----
       A fresh geometric test — has the real button left the top of the
       screen — on load, on intersection changes and on scroll end. An
       IntersectionObserver alone misses a flick straight past the anchor. */
    (function stickyBar() {
      var bar = document.querySelector('[data-zsatc]');
      var anchor = document.querySelector('[data-zatc-anchor]');
      if (!bar || !anchor) { return; }
      var on = null;
      function evaluate() {
        var next = anchor.getBoundingClientRect().bottom < 0;
