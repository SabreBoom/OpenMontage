      var noteBag = sec.querySelector('[data-note-bag]');
      on(document, 'cart:painted', function (e) {
        var c = e.detail;
        if (!qo || !c || !c.items) return;
        var held = c.items.reduce(function (s, i) { return s + (i.product_id === pid ? i.quantity : 0); }, 0);
        var next = held > 0;
        if (next === plain) return;
        plain = next;
        qo.classList.toggle('is-plain', plain);
        if (noteAuto) noteAuto.hidden = plain;
        if (noteBag) noteBag.hidden = !plain;
        paint();
      });

      /* ---- gallery ----
         Thumbnails, dots and a programmatic move are a quick fade on the
         target photograph (180ms) after an instant jump, so a long move
         never sweeps through the other bottles; a swipe stays native. */
      var gallery = (function () {
        var gal = sec.querySelector('[data-gal]');
        var api = { show: function () {} };
        if (!gal) return api;
        var track = gal.querySelector('[data-gal-track]');
        var dots = gal.querySelector('[data-gal-dots]');
        var thumbs = gal.querySelector('[data-gal-thumbs]');
        var slides = [].slice.call(track.querySelectorAll('.gal__slide'));
        var at = 0;
        function slideFor(id) {
          for (var k = 0; k < slides.length; k++) {
            var vs = (slides[k].getAttribute('data-variant') || '').split(' ');
            if (vs.indexOf(String(id)) > -1) return k;
          }
          return -1;
        }
        if (slides.length < 2) {
          if (dots) dots.hidden = true;
          if (thumbs) thumbs.hidden = true;
          return api;
        }
        function leftOf(i) {
          return track.scrollLeft + slides[i].getBoundingClientRect().left - track.getBoundingClientRect().left;
        }
        function sync(i) {
          at = i;
          [dots, thumbs].forEach(function (box) {
            if (box) [].forEach.call(box.children, function (b, k) { b.setAttribute('aria-current', String(k === i)); });
          });
        }
        function go(i, how) {
          if (i < 0 || i >= slides.length) return;
          var left = leftOf(i);
          if (Math.abs(track.scrollLeft - left) < 2) { sync(i); return; }
          if (how === 'smooth' && !rm.matches) {
            track.scrollTo({ left: left, behavior: 'smooth' });
          } else {
            track.scrollTo({ left: left, behavior: 'auto' });
            var im = slides[i].querySelector('img');
            if (how === 'fade' && !rm.matches && im && im.animate) {
              im.animate([{ opacity: 0.25 }, { opacity: 1 }], { duration: 180, easing: 'cubic-bezier(.2,.7,.2,1)' });
            }
          }
          sync(i);
        }
        var n = slides.length;
        slides.forEach(function (s, i) {
          var lab = s.getAttribute('data-label');
          var name = (lab ? 'Show ' + lab + ' photo, ' : 'Show photo ') + (i + 1) + ' of ' + n;
          if (dots) {
            var d = document.createElement('button');
            d.type = 'button'; d.className = 'gal__dot'; d.tabIndex = -1;
            d.setAttribute('aria-label', name);
            d.setAttribute('aria-current', String(i === 0));
            d.addEventListener('click', function () { go(i, 'fade'); });
            dots.appendChild(d);
          }
          if (thumbs) {
            var t = document.createElement('button');
            t.type = 'button';
            t.className = 'gal__thumb' + (s.classList.contains('gal__slide--photo') ? ' gal__thumb--photo' : ' zv-studio');
            t.setAttribute('aria-label', name);
            t.setAttribute('aria-current', String(i === 0));
            var src = s.getAttribute('data-thumb');
            if (src) {
              var ti = document.createElement('img');
              ti.src = src; ti.alt = ''; ti.width = 72; ti.height = 72; ti.loading = 'lazy'; ti.decoding = 'async';
              t.appendChild(ti);
            }
            /* mousedown default would move focus and, on a double click,
               select text nearby; the click itself only moves the track. */
            t.addEventListener('mousedown', function (e) { if (e.detail > 1) e.preventDefault(); });
            t.addEventListener('click', function (e) { e.preventDefault(); go(i, 'fade'); });
            thumbs.appendChild(t);
          }
        });
        on(track, 'keydown', function (e) {
          if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
          var next = e.key === 'ArrowRight' ? at + 1 : at - 1;
          if (next < 0 || next >= slides.length) return;
          e.preventDefault();
          go(next, 'smooth');
        });
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (es) {
            es.forEach(function (x) { if (x.isIntersecting) sync(slides.indexOf(x.target)); });
          }, { root: track, threshold: 0.6 });
          slides.forEach(function (s) { io.observe(s); });
          if (ac) ac.signal.addEventListener('abort', function () { io.disconnect(); });
        }
        /* An option shows the photograph assigned to it (studio slot or the
           variant's own image in Shopify). An option with none leaves the
           gallery where it is, rather than guessing by position. */
        api.show = function (id, initial) {
          var k = slideFor(id);
          if (k < 0) return;
          go(k, initial ? 'jump' : 'fade');
        };
        return api;
      })();

      paint();
      markRadios(curId);

      /* ---- the pair card ---- */
      var pc = sec.querySelector('[data-pairc]');
      if (pc) {
        var add = pc.querySelector('[data-pairc-add]');
        var stEl = pc.querySelector('[data-pairc-state]');
        var priceEl = pc.querySelector('[data-pairc-price]');
        var tagEl = pc.querySelector('[data-pairc-tag]');
        var errEl = pc.querySelector('[data-pairc-err]');
        var live = pc.querySelector('[data-pairc-live]');
        var pick = pc.querySelector('[data-pairc-avar]');
        var form = pc.querySelector('[data-pairc-act]');
        var aInput = pc.querySelector('[data-pairc-aid]');
        var aPics = [].slice.call(pc.querySelectorAll('[data-pairc-aimg]'));
        var aId = Number(pc.getAttribute('data-a-product')), bId = Number(pc.getAttribute('data-b-product'));
        var title = pc.getAttribute('data-title') || '';
        var name = pc.getAttribute('data-name') || 'The pair';
        var aShort = pc.getAttribute('data-a-short') || '', bShort = pc.getAttribute('data-b-short') || '';
        var labelOffer = add.getAttribute('data-label-offer') || add.textContent;
        var labelPlain = add.getAttribute('data-label-plain') || labelOffer;
        var blocked = pc.getAttribute('data-state') === 'blocked';
        /* The shared pair rule (zorev.js: ZorevPair.applies), with the same
           expression as a fallback: G units of A and H units of B in the
           bag after the add. */
        var applies = function (g, h) {
          if (window.ZorevPair && typeof window.ZorevPair.applies === 'function') return !!window.ZorevPair.applies(g, h);
          return g >= 1 && h >= 1 && (h <= 2 || g >= h);
        };

        /* The GODA option for the pair: the button, the form's own
           items[][id] (the no-script post) and the picture all follow it. */
        var setA = function (id) {
          id = String(id);
          add.setAttribute('data-a', id);
          if (aInput) aInput.value = id;
          var has = aPics.some(function (el) { return el.getAttribute('data-pairc-aimg') === id; });
          if (has) aPics.forEach(function (el) { el.hidden = el.getAttribute('data-pairc-aimg') !== id; });
        };
        if (pick) on(pick, 'change', function () { setA(pick.value); });
        if (pc.getAttribute('data-follow') === 'a') {
          on(document, 'variant:change', function (e) { if (e.detail && e.detail.id) setA(String(e.detail.id)); });
        }
        var qtyOf = function (c, pid) {
          return (c.items || []).reduce(function (s, i) { return s + (i.product_id === pid ? i.quantity : 0); }, 0);
        };
        /* Shopify's own discount titles and amounts for this cart (zorev.js
           exposes the same reader the drawer uses). */
        var discountsOf = function (c) {
          if (window.ZorevDiscountsOf) return window.ZorevDiscountsOf(c);
          var out = [];
          (c.items || []).forEach(function (i) {
            (i.line_level_discount_allocations || []).forEach(function (a) {
              out.push({ title: a.discount_application && a.discount_application.title, amount: Number(a.amount) || 0 });
            });
          });
          return out;
        };
        on(document, 'cart:painted', function (e) {
          var c = e.detail || {};
          var hit = discountsOf(c).filter(function (d) { return d.title === title && d.amount > 0; })[0];
          var a = qtyOf(c, aId), b = qtyOf(c, bId);
          blocked = false;
          stEl.textContent = '';
          if (hit) {
            pc.setAttribute('data-state', 'in-bag');
            stEl.appendChild(document.createTextNode('✓ ' + name + ' is in your bag, saving ' + short(hit.amount) + '. '));
            var link = document.createElement('a');
            link.href = '/cart'; link.textContent = 'View bag';
            stEl.appendChild(link);
            stEl.hidden = false;
            if (priceEl) priceEl.hidden = false;
            if (tagEl) tagEl.hidden = true;
          } else if (!applies(a + 1, b + 1)) {
            blocked = true;
            pc.setAttribute('data-state', 'blocked');
            stEl.textContent = 'Your bag already has more ' + bShort + ' than ' + aShort +
              ', so adding one of each would not get the pair saving. Every saving shows in your bag before checkout.';
            stEl.hidden = false;
            if (priceEl) priceEl.hidden = true;
            if (tagEl) tagEl.hidden = true;
          } else {
            pc.removeAttribute('data-state');
            stEl.hidden = true;
            if (priceEl) priceEl.hidden = false;
            if (tagEl) tagEl.hidden = false;
          }
          if (add.getAttribute('aria-busy') !== 'true') add.textContent = blocked ? labelPlain : labelOffer;
        });

        on(form, 'submit', function (e) {
          if (!window.fetch) return;
          e.preventDefault();
          if (add.getAttribute('aria-busy') === 'true') return;
          add.setAttribute('aria-busy', 'true');
          add.setAttribute('aria-disabled', 'true');
          add.textContent = 'Adding…';
          errEl.hidden = true; errEl.textContent = '';
          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ items: [
              { id: Number(add.getAttribute('data-a')), quantity: 1 },
              { id: Number(add.getAttribute('data-b')), quantity: 1 }
            ] })
          })
            .then(function (r) {
              if (r.ok) return r.json();
              return r.json().then(function (j) { throw new Error((j && (j.description || j.message)) || ''); },
                                   function () { throw new Error(''); });
            })
            .then(function () {
              if (live) live.textContent = name + ' added to your bag.';
              if (window.ZorevCart) { window.ZorevCart.show(add); return window.ZorevCart.fetch(); }
              window.location.href = '/cart';
            })
            .catch(function (err) {
              errEl.textContent = (err && err.message) || 'The pair could not be added. Please try again.';
              errEl.hidden = false;
            })
            .then(function () {
              add.removeAttribute('aria-busy');
              add.removeAttribute('aria-disabled');
              add.textContent = blocked ? labelPlain : labelOffer;
            });
        });
      }

      /* ---- sticky bar (phones) ----
         A fresh geometric test — has the real form left the top of the
         screen — on load, on intersection changes and on scroll. */
      (function () {
        var bar = sec.querySelector('[data-zsatc]');
        var anchor = sec.querySelector('[data-zatc-anchor]');
        if (!bar || !anchor) return;
        var state = null;
        function evaluate() {
          var next = anchor.getBoundingClientRect().bottom < 0;
          if (next === state) return;
          state = next;
          bar.classList.toggle('is-on', next);
          bar.setAttribute('aria-hidden', String(!next));
          document.documentElement.classList.toggle('satc-on', next);
        }
        evaluate();
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(evaluate, { threshold: 0 });
          io.observe(anchor);
          if (ac) ac.signal.addEventListener('abort', function () { io.disconnect(); document.documentElement.classList.remove('satc-on'); });
        }
        var queued = false;
        on(window, 'scroll', function () {
          if (queued) return;
          queued = true;
          requestAnimationFrame(function () { queued = false; evaluate(); });
        }, { passive: true });
      })();
    };

    var me = document.currentScript;
    Z.init(me && me.closest ? me.closest('[data-zpdp]') : document.querySelector('[data-zpdp]'));
    if (!Z.bound) {
      Z.bound = true;
      document.addEventListener('shopify:section:load', function (e) {
        var s = e.target && e.target.querySelector ? e.target.querySelector('[data-zpdp]') : null;
        if (s) window.ZorevPDP.init(s);
      });
      document.addEventListener('shopify:section:unload', function (e) {
        var s = e.target && e.target.querySelector ? e.target.querySelector('[data-zpdp]') : null;
        if (s && s.__zpdpStop) s.__zpdpStop();
      });
    }
  })();
  </script>
</div>
{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "sticky_atc", "label": "Sticky add-to-cart bar", "default": true,
      "info": "Phones and small tablets only. It appears once the real button scrolls off screen, shows the option, quantity and price it will add, and the page reserves space for it so it never covers content." },
    { "type": "paragraph", "content": "Photographs: with Theme settings > Studio images on, the gallery shows the packshots set there for this product's options; otherwise the product's own photographs from Products > Media. Either way, choosing an option shows the photograph assigned to that option." },
    { "type": "paragraph", "content": "The quantity offer reads each product's 'Quantity offer' metafield. The pair card reads Theme settings > Offers. The story under the buy box comes from the description's own headings (Details, How to use, What's included); the accordion blocks below close it as 'Good to know', beside the 'Story close-up' block set to the product." }
  ],
  "blocks": [
    { "type": "scene", "name": "In-use photograph",
      "settings": [
        { "type": "paragraph", "content": "A photograph of the real product in use, added to the gallery after the product's own photographs. Never a photograph of a different product or a redesigned one." },
        { "type": "product", "id": "product", "label": "Product", "info": "The page this photograph belongs to. Empty: every product page." },
        { "type": "image_picker", "id": "image", "label": "Photograph", "info": "Square frame; at least 1600 px on the short side." },
        { "type": "text", "id": "image_alt", "label": "Description", "info": "What is in the picture, for screen readers." },
        { "type": "text", "id": "position", "label": "Crop", "default": "50% 50%", "info": "Where the square centres on the photograph, as x% y%." }
      ] },
    { "type": "story_photo", "name": "Story close-up",
      "settings": [
        { "type": "paragraph", "content": "A close-up of the product beside its story (What it is, How to use…): a region of one of the makers' own packshots. Never a picture of a different product, and nothing composited into a scene." },
        { "type": "product", "id": "product", "label": "Product", "info": "The page this picture belongs to. Empty: every product page." },
        { "type": "image_picker", "id": "image", "label": "Packshot" },
        { "type": "text", "id": "region", "label": "Region", "default": "0,0,1000,1000", "info": "left,top,width,height in thousandths of the picture (0,0,1000,1000 = all of it). Shown at the region's own pixels at most, never enlarged." },
        { "type": "checkbox", "id": "plate", "label": "On the studio plate", "default": false, "info": "For packshots shot on white: the white dissolves into the warm studio plate, as in the gallery." },
        { "type": "text", "id": "image_alt", "label": "Description", "info": "What the close-up shows, for screen readers." }
      ] },
    { "type": "accordion", "name": "Accordion",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "content", "label": "Content",
          "info": "State only what your policies and settings actually support." }
      ] }
  ]
}
{% endschema %}
