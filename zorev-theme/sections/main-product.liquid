      }
      if ('onscrollend' in window) {
        window.addEventListener('scrollend', evaluate, { passive: true });
      }
      var queued = false;
      window.addEventListener('scroll', function () {
        if (queued) { return; }
        queued = true;
        requestAnimationFrame(function () { queued = false; evaluate(); });
      }, { passive: true });
    })();

    /* ---- gallery ---- */
    document.querySelectorAll('[data-gal]').forEach(function (gal) {
      var track  = gal.querySelector('[data-gal-track]');
      var dots   = gal.querySelector('[data-gal-dots]');
      var thumbs = gal.querySelector('[data-gal-thumbs]');
      var slides = [].slice.call(track.querySelectorAll('.gal__slide'));
      if (slides.length < 2) {
        if (dots) dots.style.display = 'none';
        if (thumbs) thumbs.style.display = 'none';
        return;
      }
      function go(i) {
        track.scrollTo({
          left: slides[i].offsetLeft - track.offsetLeft,
          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
        });
      }
      function sync(i) {
        if (dots) [].forEach.call(dots.children, function (d, k) { d.setAttribute('aria-current', String(k === i)); });
        if (thumbs) [].forEach.call(thumbs.children, function (t, k) { t.setAttribute('aria-current', String(k === i)); });
      }
      slides.forEach(function (s, i) {
        if (dots) {
          var d = document.createElement('button');
          d.type = 'button'; d.className = 'gal__dot'; d.setAttribute('role', 'tab');
          d.setAttribute('aria-label', 'Image ' + (i + 1));
          d.setAttribute('aria-current', String(i === 0));
          d.addEventListener('click', function () { go(i); });
