    };

    /* ---- quantity offer ----
       The radios are the state. Everything here only mirrors them — into
       the button label, the sticky bar's hidden quantity field and the
       per-option totals — and it does so synchronously on change, so a fast
       double-tap can never leave the label disagreeing with the selection. */
    var qo = document.querySelector('[data-qo]');
    var price = {{ v.price | json }};
    var available = {{ v.available | json }};
    var save = {};
    try { save = JSON.parse(qo ? qo.getAttribute('data-save') : '{}') || {}; } catch (e) { save = {}; }

    function currentQty() {
      var c = qo && qo.querySelector('.qo__in:checked');
      return c ? Number(c.value) : 1;
    }
    function totalFor(q) { return price * q - (Number(save[String(q)]) || 0); }

    function paint() {
      var q = currentQty(), tot = totalFor(q);
      document.querySelectorAll('[data-add]').forEach(function (b) {
        if (b.getAttribute('aria-busy') === 'true') return;
        b.textContent = available ? (q > 1 ? 'Add ' + q + ' to bag · ' : 'Add to bag · ') + short(tot) : 'Sold out';
      });
      document.querySelectorAll('[data-price]').forEach(function (el) { el.textContent = short(price); });
      document.querySelectorAll('[data-qo-mirror]').forEach(function (i) { i.value = q; });
      var s = document.querySelector('[data-satc-sum]');
      if (s) s.textContent = (q > 1 ? q + ' ' + (qo ? qo.getAttribute('data-units') : '') + ' · ' : '') + short(tot);
      if (!qo) return;
      qo.querySelectorAll('.qo__opt').forEach(function (l) {
        var i = l.querySelector('.qo__in');
        l.classList.toggle('is-on', !!(i && i.checked));
      });
      Object.keys(save).forEach(function (k) {
        var n = Number(k), t = totalFor(n);
        var tEl = qo.querySelector('[data-qo-total="' + n + '"]');
        var wEl = qo.querySelector('[data-qo-was="' + n + '"]');
        var eEl = qo.querySelector('[data-qo-each="' + n + '"]');
        if (tEl) tEl.textContent = short(t);
        if (wEl) wEl.lastChild.textContent = short(price * n);
        if (eEl) eEl.textContent = short(Math.round(t / n)) + ' each';
      });
    }

    if (qo) qo.addEventListener('change', paint);
    document.addEventListener('variant:change', function (e) {
      if (e.detail) {
        if (typeof e.detail.price === 'number') price = e.detail.price;
        if (typeof e.detail.available === 'boolean') available = e.detail.available;
      }
      paint();
    });
    document.addEventListener('atc:done', paint);
    paint();

    /* ---- the pair card ----
       Reads the real cart (zorev.js fires cart:painted after every
       repaint). Three states:
         in-bag   Shopify's own discounts for this cart include the pair
         blocked  the bag already holds more of B than of A, so adding one
                  of each would still leave B ahead — Shopify would not
                  apply the pair, so the card stops promising it
         offer    anything else */
    var pc = document.querySelector('[data-pairc]');
    var cfgEl = document.querySelector('[data-pair-config]');
    var cfg = null;
    try { cfg = cfgEl ? JSON.parse(cfgEl.textContent) : null; } catch (e) { cfg = null; }

    if (pc && cfg) {
      var btn = pc.querySelector('[data-pairc-add]');
      var stateEl = pc.querySelector('[data-pairc-state]');
      var priceEl = pc.querySelector('[data-pairc-price]');
      var live = pc.querySelector('[data-pairc-live]');
      var pick = pc.querySelector('[data-pairc-avar]');
      var aId = Number(pc.getAttribute('data-a-product')), bId = Number(pc.getAttribute('data-b-product'));

      if (pick) pick.addEventListener('change', function () { btn.setAttribute('data-a', pick.value); });
      if (pc.getAttribute('data-follow') === 'a') {
        document.addEventListener('variant:change', function (e) {
          if (e.detail && e.detail.id) btn.setAttribute('data-a', e.detail.id);
        });
      }

      var qtyOf = function (c, pid) {
        return (c.items || []).reduce(function (n, i) { return n + (i.product_id === pid ? i.quantity : 0); }, 0);
      };

      document.addEventListener('cart:painted', function (e) {
        var c = e.detail || {};
        var list = window.ZorevDiscountsOf ? window.ZorevDiscountsOf(c) : [];
        var hit = list.filter(function (d) { return d.title === cfg.title; })[0];
        var a = qtyOf(c, aId), b = qtyOf(c, bId);
        if (hit) {
          pc.setAttribute('data-state', 'in-bag');
          stateEl.hidden = false;
          stateEl.innerHTML = '✓ ' + cfg.name + ' is in your bag — saving ' + money(hit.amount).replace(/[.,]00(?=\D*$)/, '') +
            '. <a href="/cart">View bag</a>';
          if (priceEl) priceEl.hidden = false;
        } else if (b > a) {
          pc.setAttribute('data-state', 'blocked');
          stateEl.hidden = false;
          stateEl.textContent = 'The pair saving applies when your bag has at least as many ' +
            cfg.a.short + ' as ' + cfg.b.short + '.';
          if (priceEl) priceEl.hidden = true;
        } else {
          pc.removeAttribute('data-state');
          stateEl.hidden = true;
          stateEl.textContent = '';
          if (priceEl) priceEl.hidden = false;
        }
      });

      btn.addEventListener('click', function () {
        if (btn.getAttribute('aria-busy') === 'true') return;
        var label = btn.textContent;
        btn.setAttribute('aria-busy', 'true');
        btn.disabled = true;
        btn.textContent = 'Adding…';
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: [
            { id: Number(btn.getAttribute('data-a')), quantity: 1 },
            { id: Number(btn.getAttribute('data-b')), quantity: 1 }
          ] })
        })
          .then(function (r) { return r.ok ? r.json() : r.json().then(function (j) { throw new Error(j && j.description); }); })
          .then(function () {
            if (window.ZorevCart) { window.ZorevCart.show(); return window.ZorevCart.fetch(); }
            window.location.href = '/cart';
          })
          .catch(function (err) {
            if (live) live.textContent = (err && err.message) || 'The pair could not be added. Please try again.';
          })
          .then(function () {
