{%- comment -%}
  Product page (V15).

  The buy box answers a first-time customer's questions in the order they
  ask them: what is it, what does it cost, which one, how many, add it.
  Below it, the product's story — what it is, how to use it, what's
  included, good to know — set as short headed blocks beside one quiet,
  product-free landscape.

  Prices on this page are never invented here. The quantity offer reads
  the product's "Quantity offer" metafield (zorev.offer), whose savings
  mirror the automatic discounts in Discounts; the pair card reads theme
  settings that mirror the pair discount (snippets/pair-price). Every total
  was checked against Shopify's own discount engine before it was written.

  The product form posts natively: a hidden "id" and real radios named
  "quantity" sit INSIDE it. zorev.js posts the same form with FormData;
  with JavaScript off the browser posts it, and the option picker (a small
  GET form of its own) reloads the page on the chosen option, so the id in
  the form is always the option on screen.

  Photographs: with Theme settings > Studio images on, the gallery shows
  the makers' own packshots assigned there to this product's options (slot
  order), the selected option's first; otherwise the product's media from
  Shopify. Choosing an option shows the photograph assigned to THAT option
  (by variant id, never by position).
{%- endcomment -%}
{%- liquid
  assign v = product.selected_or_first_available_variant
  assign multi = false
  if product.variants.size > 1
    assign multi = true
  endif
  assign shots = product.media | where: 'media_type', 'image'
  assign media_ids = product.media | map: 'id' | join: ','
  assign media_ids = ',' | append: media_ids | append: ','
  assign gallery = product.metafields.zorev.gallery.value
  assign has_gallery = false
  if gallery.size > 0
    assign has_gallery = true
  endif
  assign offer = product.metafields.zorev.offer.value
  assign unit_one = offer.unit | default: 'item'
  assign unit_many = offer.units | default: 'items'
  assign jd = product.metafields.judgeme.review_widget_data.value
  assign rcount = jd.number_of_reviews | default: 0
  assign pa = settings.pair_product_a
  assign pb = settings.pair_product_b
  assign show_pair = false
  if settings.pair_enabled and pa != blank and pb != blank and pa.title != blank and pb.title != blank
    if product.id == pa.id or product.id == pb.id
      assign show_pair = true
    endif
  endif
  assign max_tier = 1
  for t in offer.breaks
    if t.qty > max_tier
      assign max_tier = t.qty
    endif
  endfor

  comment
    What the bag already holds (the cart this page was rendered with; the
    script re-reads it on every cart repaint). This product's units decide
    whether the quantity rows may promise a tier saving; the pair products'
    units decide whether the pair card may promise the pair saving.
  endcomment
  assign in_bag_qty = 0
  assign bag_a = 0
  assign bag_b = 0
  for item in cart.items
    if item.product_id == product.id
      assign in_bag_qty = in_bag_qty | plus: item.quantity
    endif
    if pa != blank and item.product_id == pa.id
      assign bag_a = bag_a | plus: item.quantity
    elsif pb != blank and item.product_id == pb.id
      assign bag_b = bag_b | plus: item.quantity
    endif
  endfor
  assign tiers_plain = false
  if in_bag_qty > 0
    assign tiers_plain = true
  endif

  comment
    Studio images (Theme settings > Studio images): slot N pairs a numeric
    variant id (studio_N_variant) with a packshot (studio_N_image). The
    slots that belong to this product's options become the gallery, in
    slot order, with the selected option's slots first so its picture is
    the first one painted (the LCP) and a ?variant= link never sweeps past
    other bottles on load.
  endcomment
  assign sel_keys = ''
  assign other_keys = ''
  if settings.studio_mode == 'on'
    for n in (1..10)
      assign kv = 'studio_' | append: n | append: '_variant'
      assign ki = 'studio_' | append: n | append: '_image'
      assign sv = settings[kv] | strip
      if sv == blank or settings[ki] == blank
        continue
      endif
      for var in product.variants
        assign vid = var.id | append: ''
        if vid == sv
          if var.id == v.id
            assign sel_keys = sel_keys | append: 's' | append: n | append: ','
          else
            assign other_keys = other_keys | append: 's' | append: n | append: ','
          endif
          break
        endif
      endfor
    endfor
  endif
  assign slide_keys = sel_keys | append: other_keys
  if slide_keys == blank
    comment
      No studio slots for this product: its own media from Shopify, in
      their order, except that the selected option's own photograph leads.
    endcomment
    assign first_mid = v.featured_media.id | default: 0
    assign first_key = ''
    assign rest_keys = ''
    for m in shots limit: 10
      if m.id == first_mid and first_key == blank
        assign first_key = 'm' | append: forloop.index0 | append: ','
      else
        assign rest_keys = rest_keys | append: 'm' | append: forloop.index0 | append: ','
      endif
    endfor
    assign slide_keys = first_key | append: rest_keys
  endif
  assign keys = slide_keys | split: ','
  assign n_slides = keys.size
  assign ladder = '480,640,800,1000,1200,1400' | split: ','
  assign gal_sizes = '(min-width: 1240px) 590px, (min-width: 900px) 48vw, calc(100vw - 40px)'
-%}
<div class="zpdp-root" data-zpdp>
<section class="band zpdp">
  <div class="wrap pdp" data-variants data-product-id="{{ product.id }}" data-money-format="{{ shop.money_format | strip_html | escape }}">

    {%- comment -%}
      One scroll-snap track at every size: swiping is the native gesture on
      a phone, and every frame stays in the DOM, so nothing re-decodes on a
      tap. On desktop the gallery is the sticky column. Thumbnails (desktop)
      and dots (phones) are drawn by the script below; each slide says which
      option it shows (data-variant, data-label), so both can name it.
    {%- endcomment -%}
    <div class="pdp__media gal" data-gal>
      <div class="gal__track" data-gal-track tabindex="0" role="group"
           aria-label="{{ product.title | strip_html | escape }} photographs">
        {%- for key in keys -%}
          {%- liquid
            assign kind = key | slice: 0
            assign ref = key | slice: 1, 9
            assign img = nil
            assign s_vars = ''
            assign s_label = ''
            assign s_mid = ''
            assign s_alt = ''
            if kind == 's'
              assign ki = 'studio_' | append: ref | append: '_image'
              assign kv = 'studio_' | append: ref | append: '_variant'
              assign img = settings[ki]
              assign s_vars = settings[kv] | strip
            else
              assign mi = ref | plus: 0
              assign m = shots[mi]
              assign img = m.preview_image
              assign s_mid = m.id
              assign s_alt = m.alt
              for var in product.variants
                if var.featured_media.id == m.id
                  assign s_vars = s_vars | append: var.id | append: ' '
                endif
              endfor
              assign s_vars = s_vars | strip
            endif
            assign first_var = s_vars | split: ' ' | first
            if multi and first_var != blank
              for var in product.variants
                assign vid = var.id | append: ''
                if vid == first_var
                  capture s_label
                    render 'zvlabel', t: var.title
                  endcapture
                  assign s_label = s_label | strip
                  break
                endif
              endfor
            endif
            if s_alt == blank
              if s_label != blank
                assign s_alt = product.title | append: ', ' | append: s_label
              elsif n_slides > 1
                assign s_alt = product.title | append: ', photo ' | append: forloop.index | append: ' of ' | append: n_slides
              else
                assign s_alt = product.title
              endif
            endif
            assign src_w = img.width | at_most: 1000
          -%}
          {%- if img != blank -%}
            <div class="gal__slide gal__slide--shot zv-studio"
                 data-thumb="{{ img | image_url: width: 160 }}"
                 {%- if s_vars != blank %} data-variant="{{ s_vars }}"{% endif -%}
                 {%- if s_label != blank %} data-label="{{ s_label | escape_once }}"{% endif -%}
                 {%- if s_mid != blank %} data-media-id="{{ s_mid }}"{% endif %}>
              <img src="{{ img | image_url: width: src_w }}"
                   srcset="{%- for w in ladder -%}{%- assign wn = w | plus: 0 -%}{%- if wn < img.width -%}{{ img | image_url: width: wn }} {{ wn }}w, {% endif -%}{%- endfor -%}{{ img | image_url: width: img.width }} {{ img.width }}w"
                   sizes="{{ gal_sizes }}"
                   alt="{{ s_alt | strip_html | escape_once }}"
                   width="{{ img.width }}" height="{{ img.height }}"
                   {% if forloop.first %}fetchpriority="high" data-vt-static data-vt-product="{{ product.handle | escape }}"{% else %}loading="lazy" decoding="async"{% endif %}>
            </div>
          {%- endif -%}
        {%- endfor -%}
        {%- comment -%}
          In-use photographs from the "Scene" blocks, after the product's own
          photographs. A block set to a product shows on that product's page
          only. (Both are disabled: they are composites, and need the owner's
          approval before they are shown.)
        {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'scene' and block.settings.image != blank -%}
            {%- if block.settings.product == blank or block.settings.product.id == product.id -%}
              <div class="gal__slide gal__slide--photo" data-thumb="{{ block.settings.image | image_url: width: 160 }}" {{ block.shopify_attributes }}>
                {% render 'zv-media', image: block.settings.image, sizes: '(min-width: 1240px) 1060px, (min-width: 900px) 86vw, 180vw', alt: block.settings.image_alt, position: block.settings.position %}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- comment -%}
          The curated gallery (zorev.gallery): real photographs and short
          silent films of this product. Anything that is the product's own
          media is skipped — shown already, or deliberately replaced by the
          studio set — so no photograph appears twice.
        {%- endcomment -%}
        {%- if has_gallery -%}
          {%- for f in gallery -%}
            {%- capture fkey -%},{{ f.id }},{%- endcapture -%}
            {%- if media_ids contains fkey -%}{%- continue -%}{%- endif -%}
            {%- assign g_alt = f.alt | default: product.title -%}
            {%- if f.media_type == 'video' -%}
              <div class="gal__slide gal__slide--photo" data-thumb="{{ f.preview_image | image_url: width: 160 }}">
                {% render 'zv-media', media: f, sizes: gal_sizes, alt: g_alt %}
              </div>
            {%- elsif f.media_type == 'image' -%}
              <div class="gal__slide gal__slide--photo" data-thumb="{{ f | image_url: width: 160 }}">
                {% render 'zv-media', image: f, sizes: gal_sizes, alt: g_alt %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
      <div class="gal__dots" data-gal-dots></div>
      <div class="gal__thumbs" data-gal-thumbs></div>
    </div>

    <div class="pdp__info">
      <h1 class="pdp__title">{{ product.title | escape }}</h1>

      {%- if rcount > 0 -%}
        <a class="pdp__rating" href="#reviews">
          {% render 'zicon', name: 'star' %}
          <span>{{ jd.average_rating | round: 1 }} &middot; {{ rcount }} {{ rcount | pluralize: 'review', 'reviews' }}</span>
        </a>
      {%- endif -%}

      <div class="pdp__pricerow">
        <p class="price pdp__price"><span data-price>{{ v.price | money_without_trailing_zeros }}</span></p>
        <p class="pdp__ship">{% render 'zicon', name: 'truck' %}<span>Free shipping, worldwide</span></p>
      </div>

      {%- if multi -%}
        {%- comment -%}
          The option picker: native radios in a fieldset, so arrow keys move
          and select as a radio group should, and the selected one is
          rendered by the server. Each carries data-variant-id, which
          zorev.js listens to (click and change) to set the id in both
          product forms. Its own GET form is the no-script path: "Show this
          option" reloads the page on ?variant=, and the product form then
          carries that id. With scripts on, that button is hidden and the
          form never submits.

          class "opt" stays on the radio for older selectors and the
          storefront tests; the chip styling it once carried is inert on a
          transparent input.
        {%- endcomment -%}
        <form class="vpick" action="{{ product.url }}" method="get" data-vpick>
          <fieldset class="vpick__set">
            <legend class="pdp__label">Option</legend>
            <div class="vpick__grid">
              {%- for var in product.variants -%}
                {%- capture sw -%}{% render 'studio-image', variant: var, product: product, widths: '120', sizes: '42px', loading: 'eager', alt: product.title %}{%- endcapture -%}
                <label class="vopt{% if var.id == v.id %} is-on{% endif %}{% unless var.available %} is-sold{% endunless %}">
                  <input class="opt vopt__in" type="radio" name="variant" value="{{ var.id }}"
                         data-variant-id="{{ var.id }}"{% if var.id == v.id %} checked{% endif %}>
                  {%- if sw != blank -%}
                    <span class="vopt__sw zv-studio" aria-hidden="true">{{ sw }}</span>
                  {%- endif -%}
                  <span class="vopt__t">{% render 'zvlabel', t: var.title %}{% unless var.available %}<span class="vopt__sold">Sold out</span>{% endunless %}</span>
                </label>
              {%- endfor -%}
            </div>
            <button class="btn btn--ghost vpick__go" type="submit">Show this option</button>
          </fieldset>
        </form>
      {%- endif -%}

      <div class="pdp__buy" data-zatc-anchor>
        {%- form 'product', product, id: 'zpf-main', class: 'pdp__form' -%}
          <input type="hidden" name="id" value="{{ v.id }}">

          {%- if offer.breaks.size > 0 -%}
            {%- comment -%}
              The multi-buy discounts apply once per order. When the bag
              already holds this product, a row here cannot know what an
              extra 2 or 3 will save on top, so the rows turn plain (count
              and regular price, no saving) and the note under the button
              says the bag works the savings out. Set here from the cart
              Shopify rendered the page with; the script re-checks it on
              every cart repaint (cart:painted). Nothing is computed here
              beyond the metafield's own tier savings.
            {%- endcomment -%}
            <fieldset class="qo{% if tiers_plain %} is-plain{% endif %}" data-qo
                      data-save='{"1":0{% for t in offer.breaks %},"{{ t.qty }}":{{ t.save }}{% endfor %}}'
                      data-unit="{{ unit_one | escape }}" data-units="{{ unit_many | escape }}">
              <legend class="pdp__label">Quantity</legend>
              <span class="qo__ring" aria-hidden="true"></span>

              <label class="qo__opt">
                <input class="qo__in" type="radio" name="quantity" value="1" checked>
                <span class="qo__dot" aria-hidden="true"></span>
                <span class="qo__main"><span class="qo__n">1 {{ unit_one | escape }}</span></span>
                <span class="qo__price"><span class="qo__total" data-qo-total="1">{{ v.price | money_without_trailing_zeros }}</span></span>
              </label>

              {%- for t in offer.breaks -%}
                {%- liquid
                  assign full = v.price | times: t.qty
                  assign tot = full | minus: t.save
                  assign each = tot | times: 1.0 | divided_by: t.qty | round
                  if tiers_plain
                    assign tot = full
                  endif
                -%}
                <label class="qo__opt">
                  <input class="qo__in" type="radio" name="quantity" value="{{ t.qty }}">
                  <span class="qo__dot" aria-hidden="true"></span>
                  <span class="qo__main">
                    <span class="qo__n">{{ t.qty }} {{ unit_many | escape }}
                      {%- if t.qty == max_tier and offer.breaks.size > 1 %} <span class="qo__tag">Best value</span>{% endif -%}
                    </span>
                    <span class="qo__each" data-qo-each="{{ t.qty }}">{{ each | money_without_trailing_zeros }} each</span>
                  </span>
                  <span class="qo__price">
                    <span class="qo__save">Save {{ t.save | money_without_trailing_zeros }}</span>
                    <span class="qo__sum">
                      <s class="qo__was" data-qo-was="{{ t.qty }}"><span class="visually-hidden">Regular price </span>{{ full | money_without_trailing_zeros }}</s>
                      <span class="qo__total" data-qo-total="{{ t.qty }}">{{ tot | money_without_trailing_zeros }}</span>
                    </span>
                  </span>
                </label>
              {%- endfor -%}
            </fieldset>
          {%- endif -%}

          {%- if offer.breaks.size > 0 and multi -%}
            {%- comment -%}
              Mix and match. With two or more chosen, one select per unit,
              each starting on the option picked above, so the default is
              what it always was and a customer can make it "one Black, one
              White". A select follows the option above until the customer
              changes that select; after that it keeps their choice. The
              multi-buy discounts count the product, not the option, so the
              saving holds for any mix. The selects have no name, so they
              never reach the cart as fields: the script posts the mix as
              line items. Hidden until the script runs; without JavaScript
              the form posts the chosen option times the quantity.
            {%- endcomment -%}
            <div class="qmix" data-qmix hidden>
              <p class="pdp__label qmix__h" id="qmix-h-{{ section.id }}">Choose each {{ unit_one | escape }}</p>
              <ol class="qmix__list" role="list" aria-labelledby="qmix-h-{{ section.id }}">
                {%- for n in (1..max_tier) -%}
                  <li class="qmix__row" data-qmix-row="{{ n }}">
                    <label class="qmix__k" for="qmix-{{ section.id }}-{{ n }}">{{ unit_one | capitalize | escape }} {{ n }}</label>
                    <span class="qmix__selw">
                      <select class="qmix__sel" id="qmix-{{ section.id }}-{{ n }}" data-qmix-sel>
                        {%- for var in product.variants -%}
                          <option value="{{ var.id }}"{% if var.id == v.id %} selected{% endif %}{% unless var.available %} disabled{% endunless %}>{% render 'zvlabel', t: var.title %}{% unless var.available %} (sold out){% endunless %}</option>
                        {%- endfor -%}
                      </select>
                    </span>
                  </li>
                {%- endfor -%}
              </ol>
              <p class="qmix__note">Mix any options.<span class="qmix__save"> The saving still applies.</span></p>
            </div>
          {%- endif -%}

          <button class="btn btn--block pdp__atc" type="submit" data-add
            {% unless v.available %}disabled{% endunless %}>
            {% if v.available %}Add to bag{% else %}Sold out{% endif %}
          </button>
          <p class="atc__err" role="alert" data-atc-error hidden></p>
        {%- endform -%}
        {%- if offer.breaks.size > 0 or show_pair -%}
          <p class="pdp__note" data-note-auto{% if tiers_plain %} hidden{% endif %}>{% render 'zicon', name: 'check' %}<span>Savings are applied automatically in your bag. No code.</span></p>
        {%- endif -%}
        {%- if offer.breaks.size > 0 -%}
          <p class="pdp__note" data-note-bag{% unless tiers_plain %} hidden{% endunless %}>{% render 'zicon', name: 'check' %}<span>Savings are worked out in your bag.</span></p>
        {%- endif -%}
      </div>

      {%- if show_pair -%}
        {%- liquid
          assign pva = pa.selected_or_first_available_variant
          if product.id == pa.id
            assign pva = v
          endif
          assign pvb = pb.selected_or_first_available_variant
          capture pp
            render 'pair-price'
          endcapture
          assign pp = pp | strip
          assign pair_full = pa.price | plus: pb.price
          assign save_txt = settings.pair_save_cents | money_without_trailing_zeros

          comment
            The pair rule (one definition site-wide; zorev.js has it as
            ZorevPair.applies): with G units of A and H units of B in the bag
            AFTER the add, Shopify applies the pair once per order iff
            G >= 1 and H >= 1 and (H <= 2 or G >= H). Verified: 1+1, 2+1,
            1+2, 2+2, 3+1, 3+3, 4+2 apply; 1+3, 2+3, 1+4 do not.
          endcomment
          assign g_after = bag_a | plus: 1
          assign h_after = bag_b | plus: 1
          assign pair_ok = false
          if h_after <= 2 or g_after >= h_after
            assign pair_ok = true
          endif
          assign pair_in_bag = false
          for app in cart.discount_applications
            if app.title == settings.pair_discount_title
              assign pair_in_bag = true
            endif
          endfor
          assign pair_state = ''
          if pair_in_bag
            assign pair_state = 'in-bag'
          elsif pair_ok == false
            assign pair_state = 'blocked'
          endif
        -%}
        {%- comment -%}
          The pair card. "Add the pair" posts one of each (the GODA option
          selected on this page, or chosen in the card on the HOYGI page).
          Rendered in the state of the cart the page was built with, then
          kept in step with the real cart (zorev.js fires cart:painted after
          every repaint). Three states:
            in-bag   Shopify's own discounts for this cart include the pair;
                     it applies once per order, so the button goes
            blocked  the rule above says one more of each would NOT get the
                     pair: no price, no saving, a plain "Add one of each"
            offer    anything else
        {%- endcomment -%}
        <div class="pairc" data-pairc{% if pair_state != blank %} data-state="{{ pair_state }}"{% endif %}
             data-a-product="{{ pa.id }}" data-b-product="{{ pb.id }}"
             data-follow="{% if product.id == pa.id %}a{% endif %}"
             data-title="{{ settings.pair_discount_title | escape }}"
             data-name="{{ settings.pair_name | escape }}"
             data-a-short="{{ pa.vendor | upcase | escape }}" data-b-short="{{ pb.vendor | upcase | escape }}">
          {%- comment -%}
            The two small pictures (snippets/pair-offer, mode 'img': the
            makers' studio packshots cut to the product itself, the same
            chooser as the homepage pair band, so the HOYGI picture is the
            clean stick-and-box cutout, not the busy lifestyle photo). One
            GODA picture per option; the chosen one shows (the others are
            hidden, so their lazy images never load until chosen).
          {%- endcomment -%}
          <div class="pairc__figs" aria-hidden="true">
            <span class="pairc__plate zv-studio">
              {%- for pv in pa.variants -%}
                {%- if pv.available or pv.id == pva.id -%}
                  <span class="pairc__pimg" data-pairc-aimg="{{ pv.id }}"{% unless pv.id == pva.id %} hidden{% endunless %}>{% render 'pair-offer', mode: 'img', product: pa, variant: pv, widths: '96,160', sizes: '60px', alt: 'none' %}</span>
                {%- endif -%}
              {%- endfor -%}
            </span>
            <span class="pairc__plus">{% render 'zicon', name: 'plus' %}</span>
            <span class="pairc__plate zv-studio"><span class="pairc__pimg">{% render 'pair-offer', mode: 'img', product: pb, variant: pvb, widths: '96,160', sizes: '60px', alt: 'none' %}</span></span>
          </div>
          <div class="pairc__txt">
            <h2 class="pairc__k">{{ settings.pair_name | escape }}</h2>
            <p class="pairc__h">{{ pa.vendor | upcase | escape }} + {{ pb.vendor | upcase | escape }}</p>
            {%- if pp != blank -%}
              <p class="pairc__p" data-pairc-price{% if pair_state == 'blocked' %} hidden{% endif %}>
                <strong>{{ pp }}</strong>
                <s><span class="visually-hidden">Regular price </span>{{ pair_full | money_without_trailing_zeros }}</s>
                <span class="pairc__save">Save {{ save_txt }}</span>
              </p>
              <p class="pairc__tag" data-pairc-tag{% if pair_state != blank %} hidden{% endif %}>One of each. The {{ save_txt }} comes off automatically in your bag, once per order.</p>
            {%- else -%}
              <p class="pairc__tag" data-pairc-tag{% if pair_state != blank %} hidden{% endif %}>One of each. The pair saving comes off automatically in your bag, once per order.</p>
            {%- endif -%}
          </div>
          {%- comment -%}
            A real form: without script it posts one of each to /cart/add
            (items[][id] / items[][quantity]) and lands on the cart page.
            With script the card posts the same two lines to /cart/add.js
            and opens the bag (data-no-ajax keeps zorev.js's own add-to-bag
            handler off this form).
          {%- endcomment -%}
          <form class="pairc__act" action="{{ routes.cart_add_url }}" method="post" data-no-ajax data-pairc-act>
            {%- if product.id != pa.id and pa.variants.size > 1 -%}
              <label class="pairc__pick">
                <span class="pairc__picklabel">{{ pa.vendor | upcase | escape }} option</span>
                <span class="pairc__selw">
                  <select name="items[][id]" data-pairc-avar>
                    {%- for pv in pa.variants -%}
                      {%- if pv.available -%}<option value="{{ pv.id }}"{% if pv.id == pva.id %} selected{% endif %}>{% render 'zvlabel', t: pv.title %}</option>{%- endif -%}
                    {%- endfor -%}
                  </select>
                </span>
              </label>
            {%- else -%}
              <input type="hidden" name="items[][id]" value="{{ pva.id }}" data-pairc-aid>
            {%- endif -%}
            <input type="hidden" name="items[][quantity]" value="1">
            <input type="hidden" name="items[][id]" value="{{ pvb.id }}">
            <input type="hidden" name="items[][quantity]" value="1">
            {%- capture offer_label -%}Add the pair{% if pp != blank %} · {{ pp }}{% endif %}{%- endcapture -%}
            <button type="submit" class="pairc__add" data-pairc-add
                    data-a="{{ pva.id }}" data-b="{{ pvb.id }}"
                    data-label-offer="{{ offer_label | escape_once }}" data-label-plain="Add one of each">{% if pair_state == 'blocked' %}Add one of each{% else %}{{ offer_label }}{% endif %}</button>
          </form>
          <p class="pairc__state" data-pairc-state{% if pair_state == blank %} hidden{% endif %}>
            {%- if pair_state == 'in-bag' -%}
              &#10003; {{ settings.pair_name | escape }} is in your bag. <a href="{{ routes.cart_url }}">View bag</a>
            {%- elsif pair_state == 'blocked' -%}
              Your bag already has more {{ pb.vendor | upcase | escape }} than {{ pa.vendor | upcase | escape }}, so adding one of each would not get the pair saving. Every saving shows in your bag before checkout.
            {%- endif -%}
          </p>
          <p class="pairc__err" role="alert" data-pairc-err hidden></p>
          <p class="visually-hidden" role="status" aria-live="polite" data-pairc-live></p>
        </div>
      {%- endif -%}

      {%- comment -%}
        Reassurance, set as part of the buy box rather than as badges: each
        line is a claim the store's own pages and policies support. The
        fulfilment line uses the Shipping page's own wording (to the
        fulfilment network within one business day; tracking by email once
        the carrier scans the parcel). "Make it right" is the refund
        policy's wording for damaged, defective or wrong items; checkout
        security is Shopify's. No "30-day returns": the refund policy lists
        personal care goods as non-returnable, which is every product here.
      {%- endcomment -%}
      <ul class="trust2" role="list">
        <li>{% render 'zicon', name: 'box' %}<span><strong>To fulfilment within one business day</strong>, tracking by email</span></li>
        <li>{% render 'zicon', name: 'lock' %}<span><strong>Secure checkout</strong>, encrypted by Shopify</span></li>
        <li>{% render 'zicon', name: 'shield' %}<span><strong>Damaged or wrong on arrival?</strong> We&rsquo;ll make it right</span></li>
        <li>{% render 'zicon', name: 'chat' %}<span><strong>Questions?</strong> <a class="trust2__mail" href="mailto:{{ settings.support_email | escape }}">{{ settings.support_email | escape }}</a> &mdash; a person answers</span></li>
      </ul>
    </div>

    {%- if section.settings.sticky_atc -%}
      {%- comment -%}
        Phones only. It appears once the real form has scrolled off the top
        of the screen, says what it will add ("GODA · Black", "2 bottles ·
        $54") and posts its own copy of the form, which the script keeps on
        the same id, quantity and mix as the real one.
      {%- endcomment -%}
      {%- capture v_label -%}{%- if multi -%}{% render 'zvlabel', t: v.title %}{%- endif -%}{%- endcapture -%}
      <div class="satc" data-zsatc aria-hidden="true">
        <div class="satc__in">
          <div class="satc__meta">
            <p class="satc__t{% if multi %} satc__t--opt{% endif %}"><span class="satc__name">{{ product.vendor | upcase | escape }}</span>{% if multi %}<span class="satc__sep"> &middot; </span><span data-satc-opt>{{ v_label | strip }}</span>{% endif %}</p>
            <p class="satc__p"><span data-satc-sum>{{ v.price | money_without_trailing_zeros }}</span></p>
          </div>
          {%- form 'product', product, id: 'zpf-sticky' -%}
            <input type="hidden" name="id" value="{{ v.id }}">
            <input type="hidden" name="quantity" value="1" data-qo-mirror>
            <button class="btn satc__btn" type="submit" data-add
              {% unless v.available %}disabled{% endunless %}>
              {% if v.available %}Add to bag{% else %}Sold out{% endif %}
            </button>
            <p class="atc__err" role="alert" data-atc-error hidden></p>
          {%- endform -%}
        </div>
      </div>
    {%- endif -%}

    <script type="application/json" data-variant-json>
      [{%- for var in product.variants -%}
        {%- capture lbl -%}{%- if multi -%}{% render 'zvlabel', t: var.title %}{%- endif -%}{%- endcapture -%}
        {"id":{{ var.id }},"price":{{ var.price }},"available":{{ var.available }},"index":{{ forloop.index0 }},"media":{{ var.featured_media.id | default: 0 }},"label":{{ lbl | strip | json }}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}]
    </script>
  </div>
</section>

{%- comment -%}
  The product's story (what it is, how to use, what's included, good to
  know) beside a close-up of the product: snippets/pdp-story.
{%- endcomment -%}
{% render 'pdp-story', product: product, blocks: section.blocks %}

  <style>
    .zpdp{padding-top:clamp(12px,1.6vw,24px)}
    /* A class that sets display beats the UA's [hidden] rule, so without
       this a hidden state line would still show. */
    .zpdp-root [hidden]{display:none !important}
    .pdp{display:grid;gap:var(--zv-4);grid-template-columns:minmax(0,1fr)}
    @media(min-width:900px){
      .pdp{grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:clamp(40px,5vw,80px);align-items:start}
      /* The gallery is the shorter column, so it is the one that sticks. */
      .pdp__media{position:sticky;top:88px}
      .pdp__info{position:static}
    }

    /* ---- gallery: studio plates on one scroll-snap track ---- */
    /* min-width:0 on the column's items, so a long row of dots can never
       set the column's minimum width and push the page sideways. */
    .gal{display:grid;gap:var(--zv-3);grid-template-columns:minmax(0,1fr)}
    .gal__track{
      display:grid;grid-auto-flow:column;grid-auto-columns:100%;gap:var(--zv-2);
      overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;scroll-behavior:auto;
      scrollbar-width:none;-webkit-overflow-scrolling:touch;border-radius:var(--zv-r-lg);
    }
    .gal__track::-webkit-scrollbar{display:none}
    .gal__track:focus-visible{outline:2px solid var(--zv-focus);outline-offset:3px}
    /* One flick, one photograph: scroll-snap-stop keeps a fast swipe from
       skipping past the next bottle. */
    .gal__slide{
      position:relative;scroll-snap-align:center;scroll-snap-stop:always;
      aspect-ratio:1/1;display:grid;place-items:center;overflow:hidden;
      border-radius:var(--zv-r-lg);background:var(--zv-plate);
      /* The packshots already carry their own white margin, which the
         plate's multiply dissolves; no extra studio padding, so the main
         picture is as large as the square allows. */
      --zv-studio-pad:0;
    }
    /* Pinned to the square (absolute, inset 0): as a grid item, height:100%
       does not resolve against the slide, so a portrait file (White 625x708,
       the HOYGI cutout 577x741) grew taller than the square and lost its
       base to overflow:hidden. Now every packshot is contained whole. */
    .gal__slide--shot img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply}
    /* A curated photograph or film fills its square edge to edge. */
    .gal__slide--photo{place-items:stretch;background:var(--zv-bg-sunken)}
    .gal__slide--photo .zv-media{position:absolute;inset:0}
    .gal__slide--photo img{width:100%;height:100%;object-fit:cover}
    /* Dots (phones): plain buttons out of the tab order — the track itself
       takes the arrow keys. 44px targets while they fit. */
    .gal__dots{display:flex;gap:var(--zv-1);justify-content:center;min-width:0}
    @media(min-width:600px){.gal__dots{display:none}}
    .gal__dot{flex:0 1 44px;min-width:24px;height:44px;padding:0;border:0;background:none;
      display:grid;place-items:center;cursor:pointer;-webkit-tap-highlight-color:transparent}
    .gal__dot::after{content:"";width:6px;height:6px;border-radius:50%;
      background:var(--zv-line-input);transition:background var(--zv-d-hover) var(--zv-ease),transform var(--zv-d-hover) var(--zv-ease)}
    .gal__dot[aria-current="true"]::after{background:var(--zv-forest);transform:scale(1.4)}
    /* Thumbnails (600px and up): small studio plates, the chosen one ringed. */
    .gal__thumbs{display:none;gap:var(--zv-2);flex-wrap:wrap}
    @media(min-width:600px){.gal__thumbs{display:flex}}
    .gal__thumb{position:relative;width:64px;height:64px;padding:0;border:0;cursor:pointer;--zv-studio-pad:0;
      border-radius:var(--zv-r-md);overflow:hidden;background:var(--zv-plate);
      -webkit-user-select:none;user-select:none;touch-action:manipulation;-webkit-tap-highlight-color:transparent;
      box-shadow:inset 0 0 0 1px var(--zv-line);transition:box-shadow var(--zv-d-hover) var(--zv-ease)}
    @media(min-width:1100px){.gal__thumb{width:72px;height:72px}}
    .gal__thumb img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;pointer-events:none}
    .gal__thumb--photo img{object-fit:cover;mix-blend-mode:normal}
    @media (hover:hover) and (pointer:fine){ .gal__thumb:hover{box-shadow:inset 0 0 0 1px var(--zv-line-input)} }
    .gal__thumb[aria-current="true"]{box-shadow:inset 0 0 0 2px var(--zv-forest)}
    .gal__thumb:focus-visible{outline:2px solid var(--zv-focus);outline-offset:2px}

    /* ---- head ---- */
    /* Title at 28-40px, not the display size: the full product name runs
       to two lines, and Add to bag has to stay above the fold of a
       1366x768 laptop. */
    .pdp__title{font-size:clamp(1.75rem,1.3rem + 1.4vw,2.5rem);line-height:1.08;margin:0 0 var(--zv-2);max-width:20ch}
    .pdp__rating{display:inline-flex;align-items:center;gap:6px;min-height:44px;
      font-size:var(--zv-t-sm);color:var(--zv-text-2);text-decoration:underline;text-underline-offset:3px}
    .pdp__rating .zicon{color:var(--zv-forest)}
    .pdp__pricerow{display:flex;flex-wrap:wrap;align-items:baseline;gap:var(--zv-2) var(--zv-5);
      margin:0 0 var(--zv-3);padding-bottom:var(--zv-3);border-bottom:1px solid var(--zv-line)}
    .pdp__price{margin:0;font-size:clamp(1.375rem,1.25rem + .5vw,1.625rem);letter-spacing:-0.01em;color:var(--zv-text)}
    .pdp__ship{display:inline-flex;align-items:center;gap:8px;margin:0;
      font-size:var(--zv-t-sm);color:var(--zv-text-2)}
    .pdp__ship .zicon{color:var(--zv-forest)}
    .pdp__label{display:block;margin:0 0 var(--zv-2);padding:0;
      font-family:var(--zv-sans);font-size:var(--zv-t-micro);font-weight:600;
      letter-spacing:var(--zv-tr-caps);text-transform:uppercase;color:var(--zv-text-2)}

    /* ---- option picker: radios with the option's own packshot ---- */
    .vpick{margin:0 0 var(--zv-3)}
    .vpick__set{border:0;margin:0;padding:0;min-width:0}
    .vpick__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--zv-2)}
    .vopt{position:relative;display:flex;align-items:center;gap:var(--zv-3);min-height:52px;
      padding:5px var(--zv-3) 5px 5px;border-radius:var(--zv-r-md);background:var(--zv-bg-raised);
      box-shadow:inset 0 0 0 1px var(--zv-line-input);cursor:pointer;
      transition:box-shadow var(--zv-d-hover) var(--zv-ease),background-color var(--zv-d-hover) var(--zv-ease),transform var(--zv-d-press) var(--zv-ease)}
    /* The real radio covers the whole card, transparent: a tap anywhere on
       it is a tap on the input, and focus outlines the card. */
    .vopt__in{position:absolute;inset:0;width:100%;height:100%;margin:0;padding:0;border:0;opacity:0;
      cursor:pointer;z-index:1;border-radius:inherit;min-height:0}
    @media (hover:hover) and (pointer:fine){ .vopt:hover{box-shadow:inset 0 0 0 1px var(--zv-forest)} }
    .vopt:active{transform:scale(.985);transition-duration:90ms}
    .vopt.is-on,.vopt:has(.vopt__in:checked){box-shadow:inset 0 0 0 2px var(--zv-forest);
      background:color-mix(in srgb, var(--zv-forest) 5%, var(--zv-bg-raised))}
    .vopt:has(.vopt__in:focus-visible){outline:2px solid var(--zv-focus);outline-offset:2px}
    .vopt__sw{position:relative;flex:0 0 auto;width:42px;height:42px;border-radius:var(--zv-r-sm);overflow:hidden;--zv-studio-pad:0;
      background:var(--zv-plate);display:grid;place-items:center}
    .vopt__sw img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply}
    .vopt__t{min-width:0;font-family:var(--zv-sans);font-size:var(--zv-t-sm);font-weight:600;line-height:1.25;color:var(--zv-text)}
    .vopt__sold{display:block;font-weight:400;font-size:var(--zv-t-fine);color:var(--zv-text-2)}
    .vopt.is-sold .vopt__sw{opacity:.55}
    .vpick__go{margin-top:var(--zv-3)}
    .zv-js .vpick__go{display:none}

    /* ---- quantity offer ----
       A radio group, styled. Each option is a <label> around a real radio,
       so the whole row is the target and arrow keys move natively. The
       selected state is a 2px forest edge, a filled dot and a tinted
       ground — never colour alone. */
    .qo{position:relative;border:0;margin:0 0 var(--zv-2);padding:0;min-width:0}
    .qo__opt{
      position:relative;display:grid;grid-template-columns:20px minmax(0,1fr) auto;
      align-items:center;gap:var(--zv-3);
      min-height:54px;padding:8px var(--zv-4);margin-bottom:var(--zv-2);
      border-radius:var(--zv-r-md);background:var(--zv-bg-raised);
      box-shadow:inset 0 0 0 1px var(--zv-hairline-2);cursor:pointer;
      transition:box-shadow var(--zv-d-hover) var(--zv-ease),
                 background-color var(--zv-d-hover) var(--zv-ease),
                 transform var(--zv-d-press) var(--zv-ease);
    }
    .qo__in{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;
      cursor:pointer;z-index:1;border-radius:inherit}
    @media (hover:hover) and (pointer:fine){ .qo__opt:hover{box-shadow:inset 0 0 0 1px var(--zv-forest)} }
    .qo__opt:active{transform:scale(.985);transition-duration:90ms}
    .qo__opt.is-on,
    .qo__opt:has(.qo__in:checked){
      box-shadow:inset 0 0 0 2px var(--zv-forest);
      background:color-mix(in srgb, var(--zv-forest) 5%, var(--zv-bg-raised));
    }
    .qo__opt:has(.qo__in:focus-visible){outline:2px solid var(--zv-focus);outline-offset:3px}
    /* The chosen row's edge is one ring that glides between rows, placed by
       the script; without it each row draws its own edge. */
    .qo__ring{position:absolute;left:0;right:0;top:0;height:var(--qo-h,0px);z-index:2;pointer-events:none;
      border-radius:var(--zv-r-md);box-shadow:inset 0 0 0 2px var(--zv-forest);opacity:0;
      transform:translate3d(0,var(--qo-y,0px),0);
      transition:transform var(--zv-d-spring) var(--zv-spring),height var(--zv-d-spring) var(--zv-spring),opacity var(--zv-d-hover) var(--zv-ease)}
    .qo.has-ring .qo__ring{opacity:1}
    .qo.has-ring .qo__opt.is-on,
    .qo.has-ring .qo__opt:has(.qo__in:checked){box-shadow:inset 0 0 0 1px var(--zv-hairline-2)}
    .qo__dot{width:20px;height:20px;border-radius:50%;
      box-shadow:inset 0 0 0 1.5px var(--zv-line-input);background:var(--zv-bg-raised);
      display:grid;place-items:center;transition:box-shadow var(--zv-d-hover) var(--zv-ease)}
    .qo__dot::after{content:"";width:10px;height:10px;border-radius:50%;background:var(--zv-forest);
      opacity:0;transform:scale(.5);transition:transform var(--zv-d-ui) var(--zv-ease),opacity var(--zv-d-press) var(--zv-ease)}
    .qo__opt.is-on .qo__dot,
    .qo__opt:has(.qo__in:checked) .qo__dot{box-shadow:inset 0 0 0 1.5px var(--zv-forest)}
    .qo__opt.is-on .qo__dot::after,
    .qo__opt:has(.qo__in:checked) .qo__dot::after{opacity:1;transform:scale(1)}
    .qo__main{display:grid;gap:2px;min-width:0}
    .qo__n{font-family:var(--zv-sans);font-size:var(--zv-t-body);font-weight:600;color:var(--zv-text);
      display:flex;align-items:center;flex-wrap:wrap;gap:6px 8px}
    .qo__tag{font-size:var(--zv-t-micro);font-weight:600;letter-spacing:var(--zv-tr-wide);
      text-transform:uppercase;color:var(--zv-forest);
      padding:2px 7px;border-radius:var(--zv-r-pill);
      background:color-mix(in srgb, var(--zv-forest) 9%, var(--zv-bg-raised))}
    .qo__each{font-size:var(--zv-t-fine);color:var(--zv-text-2);font-variant-numeric:tabular-nums}
    .qo__price{display:grid;justify-items:end;gap:2px;text-align:right}
    .qo__save{font-size:var(--zv-t-micro);font-weight:600;letter-spacing:var(--zv-tr-wide);
      text-transform:uppercase;color:var(--zv-forest)}
    .qo__sum{display:flex;align-items:baseline;gap:8px;font-variant-numeric:tabular-nums}
    .qo__was{font-size:var(--zv-t-fine);color:var(--zv-text-2)}
    .qo__total{font-family:var(--zv-sans);font-size:var(--zv-t-body);font-weight:600;color:var(--zv-text);
      font-variant-numeric:tabular-nums}
    /* Plain rows (the bag already holds this product): count and regular
       price only — no saving the bag may not give. */
    .qo.is-plain .qo__save,.qo.is-plain .qo__was,.qo.is-plain .qo__each,.qo.is-plain .qo__tag,
    .qo.is-plain ~ .qmix .qmix__save{display:none}

    /* ---- mix and match: one select per unit, under the quantity rows ---- */
    .qmix{display:grid;gap:var(--zv-3);margin:var(--zv-1) 0 var(--zv-3);padding:var(--zv-4);border-radius:var(--zv-r-md);
      background:var(--zv-bg-sunken)}
    .qmix.is-in{animation:qmix-in var(--zv-d-ui) var(--zv-ease) both}
    @keyframes qmix-in{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}
    .qmix__h{margin:0}
    .qmix__list{list-style:none;margin:0;padding:0;display:grid;gap:var(--zv-2)}
    .qmix__row{display:grid;grid-template-columns:5.25rem minmax(0,1fr);align-items:center;gap:var(--zv-3)}
    .qmix__k{font-size:var(--zv-t-sm);font-weight:600;color:var(--zv-text)}
    /* The chevron is drawn in the text colour (a data-URI could not follow
       the palette). 17px text: an iOS select under 16px zooms the page. */
    .qmix__selw,.pairc__selw{position:relative;display:block;min-width:0}
    .qmix__selw::after,.pairc__selw::after{content:"";position:absolute;right:18px;top:50%;width:7px;height:7px;
      margin-top:-5px;border-right:1.6px solid var(--zv-text);border-bottom:1.6px solid var(--zv-text);
      transform:rotate(45deg);pointer-events:none}
    .qmix__sel{appearance:none;-webkit-appearance:none;width:100%;min-height:48px;margin:0;
      padding:0 42px 0 var(--zv-4);border:0;border-radius:var(--zv-r-md);
      box-shadow:inset 0 0 0 1px var(--zv-line-input);color:var(--zv-text);font:inherit;font-size:var(--zv-t-body);
      background:var(--zv-bg-raised);cursor:pointer;transition:box-shadow var(--zv-d-hover) var(--zv-ease)}
    @media (hover:hover) and (pointer:fine){ .qmix__sel:hover{box-shadow:inset 0 0 0 1px var(--zv-forest)} }
    .qmix__sel:focus-visible{outline:2px solid var(--zv-focus);outline-offset:2px}
    .qmix__note{margin:0;font-size:var(--zv-t-fine);color:var(--zv-text-2)}
    @media(prefers-reduced-motion:reduce){ .qmix.is-in{animation:none} }

    .pdp__atc{min-height:54px;margin-top:var(--zv-2)}
    /* the label is re-set when the total changes; it rises into place */
    .atc__lbl,.satc__p [data-satc-sum]{display:inline-block}
    .atc__err,.pairc__err{margin:var(--zv-2) 0 0;padding:var(--zv-2) var(--zv-3);border-radius:var(--zv-r-sm);
      border:1px solid var(--zv-error, #8C2F2F);background:color-mix(in srgb, var(--zv-error, #8C2F2F) 6%, transparent);
      color:var(--zv-text);font-size:var(--zv-t-sm);max-width:none}
    .pdp__note{display:flex;align-items:flex-start;gap:8px;margin:var(--zv-3) 0 0;
      font-size:var(--zv-t-sm);line-height:1.45;color:var(--zv-text-2);max-width:none}
    .pdp__note .zicon{flex:0 0 auto;width:18px;height:18px;margin-top:1px;color:var(--zv-forest)}

    /* ---- the pair ---- */
    .pairc{
      display:grid;grid-template-columns:auto minmax(0,1fr);gap:var(--zv-3) var(--zv-4);align-items:center;
      margin:var(--zv-6) 0 0;padding:var(--zv-4);
      border-radius:var(--zv-r-lg);background:var(--zv-bg-sunken);
    }
    .pairc__figs{display:flex;align-items:center;gap:4px}
    .pairc__plate{width:60px;height:60px;border-radius:var(--zv-r-sm);overflow:hidden;--zv-studio-pad:0;
      background:var(--zv-plate);display:grid;place-items:center}
    .pairc__plate{position:relative}
    .pairc__pimg{position:absolute;inset:4px}
    .pairc__plate img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply}
    .pairc__plus{color:var(--zv-text-2);display:grid;place-items:center}
