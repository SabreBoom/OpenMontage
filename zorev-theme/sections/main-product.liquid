  </style>

  <script>
  (function () {
    'use strict';
    var money = function (c) {
      var fmt = document.querySelector('[data-variants]');
      fmt = fmt ? fmt.getAttribute('data-money-format') : null;
      if (fmt && fmt.indexOf('&') > -1) { var t = document.createElement('textarea'); t.innerHTML = fmt; fmt = t.value; }
      return window.ZorevMoney ? window.ZorevMoney(c, fmt) : '$' + (c / 100).toFixed(2);
    };
    /* Whole-dollar amounts read as "$70", not "$70.00", on the product page
       (the bag and checkout keep cents, because that is the charge). */
    var short = function (c) {
      var s = money(c);
