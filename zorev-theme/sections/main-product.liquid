          var im = s.querySelector('img');
          var t = document.createElement('button');
          t.type = 'button'; t.className = 'gal__thumb' + (s.hasAttribute('data-thumb-stage') ? ' gal__thumb--stage' : '');
          t.setAttribute('aria-label', 'View image ' + (i + 1));
          t.setAttribute('aria-current', String(i === 0));
