{%- comment -%}
  ZOREV — product story.

  One product as the hero of its own chapter: a picture of the real
  product beside a short statement, three physical facts and, optionally,
  the price ladder. The picture is the argument; the copy is a caption to it.

  Pictures, in order of preference:
    studio   (Picture = "Studio image") the makers' own packshot from Theme
             settings > Studio images, on the warm stone plate (.zv-studio),
             with an optional row of every option's packshot under it.
    photo    a square product photograph: a square frame in the content
             column, standing still.
    scene    a wide photograph or a film: bled to the screen edge, drifting a
             little slower than the page ([data-zv-scene] / [data-zv-depth]).
  The picture opens from a slightly inset frame as it arrives
  ([data-zv-reveal="media"]); nothing moves under prefers-reduced-motion.

  Tones: light (warm paper), stone (soft stone band), dark (a photo band).

  The ladder reads the product's own offer data (zorev.offer), the same
  data the product page and the line-up read. The saving itself is
  Shopify's automatic discount, shown by name in the bag.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign p = s.product
  assign has_p = false
  if p != blank and p.title != blank
    assign has_p = true
  endif
  assign offer = p.metafields.zorev.offer.value
  assign short = p.vendor | upcase
  assign dv = p.selected_or_first_available_variant

  assign use_studio = false
  if s.picture == 'studio' and has_p
    assign use_studio = true
  endif
  assign has_media = false
  if use_studio or s.photo != blank or s.video != blank
    assign has_media = true
  endif

  comment
    A square-ish photograph (the store's own product shots are 1:1) gets
    the plate layout: a square frame inside the content column instead of
    the wide, edge-bled scene frame, so the whole product shows at every
    width. A wide scene photograph or a film keeps the bleed layout.
  endcomment
  assign is_plate = false
  if use_studio
    assign is_plate = true
  elsif s.video == blank and s.photo != blank and s.photo.aspect_ratio < 1.3
    assign is_plate = true
  endif
  assign sid = 'zps-' | append: section.id
  assign tone = s.tone | default: 'light'
-%}
{%- if use_studio -%}
  {%- capture dv_label -%}{% render 'zvlabel', t: dv.title %}{%- endcapture -%}
  {%- liquid
    assign studio_alt = s.photo_alt
    if studio_alt == blank
      assign studio_alt = p.title
      unless p.has_only_default_variant
        assign studio_alt = studio_alt | append: ', ' | append: dv_label
      endunless
    endif
  -%}
{%- endif -%}
<section class="zps zps--{{ tone }} zps--media-{{ s.media_side }}{% if tone == 'dark' %} zv-dark{% endif %}{% if is_plate %} zps--plate{% endif %}" id="{{ s.anchor | default: sid | handleize }}"
         aria-labelledby="{{ sid }}-h"
         style="--zps-pos: {{ s.position | default: '50% 50%' }}; --zps-pos-m: {{ s.position_mobile | default: s.position | default: '50% 50%' }};">
  <div class="zps__grid">
    {%- if has_media -%}
      <figure class="zps__media">
        {%- if use_studio -%}
          <div class="zps__frame zv-studio{% if tone == 'stone' %} zv-studio--deep{% endif %} zv-studio--floor" data-zv-reveal="media">
            <div class="zps__studio">
              {%- comment -%}
                The plate is half the content column on a wide screen (about
                520 px at 1240) and the full width less the margins on a phone.
              {%- endcomment -%}
              {% render 'studio-image', product: p, variant: dv, index: 0, widths: '360,540,720,900,1100,1400', sizes: '(min-width: 1240px) 540px, (min-width: 900px) 44vw, calc(100vw - 40px)', class: 'zps__studio-img', loading: 'lazy', fetchpriority: 'auto', alt: studio_alt %}
            </div>
          </div>
          {%- if s.show_options and p.variants.size > 1 -%}
            <ul class="zps__opts" role="list" aria-label="{{ short | escape }} options">
              {%- for v in p.variants limit: 4 -%}
                <li class="zps__opt">
                  <span class="zps__opt-plate zv-studio{% if tone == 'stone' %} zv-studio--deep{% endif %}" aria-hidden="true">
                    {% render 'studio-image', product: p, variant: v, index: 0, widths: '120,180,240,360', sizes: '(min-width: 900px) 120px, 22vw', class: 'zps__opt-img', loading: 'lazy', fetchpriority: 'auto', alt: '' %}
                  </span>
                  <span class="zps__opt-n">{% render 'zvlabel', t: v.title %}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        {%- else -%}
          <div class="zps__frame" data-zv-reveal="media"{% unless is_plate %} data-zv-scene data-zv-scene-scroll="-0.07"{% endunless %}>
            <div class="zps__plate"{% unless is_plate %} data-zv-depth="1"{% endunless %}>
              {%- if is_plate -%}
                {% render 'zv-media', media: s.video, image: s.photo, image_mobile: s.photo_mobile, sizes: '(min-width: 1240px) 540px, (min-width: 900px) 44vw, calc(100vw - 40px)', alt: s.photo_alt %}
              {%- else -%}
                {%- comment -%} a wide scene covers a 4:5 phone frame: it is drawn about 2x the screen width there {%- endcomment -%}
                {% render 'zv-media', media: s.video, image: s.photo, image_mobile: s.photo_mobile, sizes: '(min-width: 900px) 62vw, 200vw', sizes_mobile: '100vw', alt: s.photo_alt %}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
        {%- if s.show_card and has_p and use_studio == false -%}
          <a class="zps__card zps__card--{{ s.card_corner | default: 'bottom-right' }}" href="{{ p.url }}" data-zv-reveal>
            <span class="zps__card-plate" aria-hidden="true">{% render 'studio-image', product: p, variant: dv, index: 0, widths: '120,180', sizes: '60px', class: 'zps__card-img', loading: 'lazy', fetchpriority: 'auto', alt: '' %}</span>
            <span class="zps__card-t">
              <span class="zps__card-n">{{ short | escape }}</span>
              <span class="zps__card-d">{{ s.card_line | default: p.type | escape }}</span>
              <span class="zps__card-p">{{ p.price | money_without_trailing_zeros }}</span>
            </span>
            <span class="visually-hidden"> &mdash; view {{ p.title | escape }}</span>
          </a>
        {%- endif -%}
      </figure>
    {%- endif -%}

    <div class="zps__copy" data-zv-reveal>
      {%- assign eb = s.eyebrow | default: p.type -%}
      {%- if eb != blank -%}<span class="zv-eyebrow zps__eyebrow">{{ eb | escape }}</span>{%- endif -%}
      <h2 class="zps__h" id="{{ sid }}-h">{{ s.heading | default: short }}</h2>
      {%- if s.body != blank -%}<div class="zv-lead zps__body">{{ s.body }}</div>{%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <dl class="zps__facts">
          {%- for block in section.blocks -%}
            <div class="zps__fact" {{ block.shopify_attributes }}>
              <dt>{{ block.settings.value | escape }}</dt>
              <dd>{{ block.settings.label | escape }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}

      {%- if has_p -%}
        {%- if s.show_ladder and offer.breaks.size > 0 -%}
          <ol class="zps__ladder" aria-label="{{ short | escape }} multi-buy prices">
            <li>
              <span class="zps__q">1 {{ offer.unit | default: 'unit' | escape }}</span>
              <span class="zps__t">{{ p.price | money_without_trailing_zeros }}</span>
            </li>
            {%- for t in offer.breaks -%}
              {%- assign tot = p.price | times: t.qty | minus: t.save -%}
              <li>
                <span class="zps__q">{{ t.qty }} {{ offer.units | default: 'units' | escape }}</span>
                <span class="zps__t">{{ tot | money_without_trailing_zeros }}</span>
                <span class="zps__s">Save {{ t.save | money_without_trailing_zeros }}</span>
              </li>
            {%- endfor -%}
          </ol>
          <p class="zps__fine">Applied automatically in your bag{% if p.variants.size > 1 %}, and you can mix options{% endif %}. No code.</p>
        {%- endif -%}
        {%- assign cta = s.cta_label -%}
        {%- if cta == blank -%}{%- assign cta = 'Shop ' | append: short -%}{%- endif -%}
        <div class="zps__act">
          {%- if s.cta_style == 'button' -%}
            <a class="zv-btn" href="{{ p.url }}">{{ cta | escape }}</a>
          {%- else -%}
            <a class="zps__link zps__link--main" href="{{ p.url }}">{{ cta | escape }}<span aria-hidden="true">&rarr;</span></a>
          {%- endif -%}
          {%- if s.link_label != blank -%}
            <a class="zps__link" href="{{ s.link_url | default: p.url }}">{{ s.link_label | escape }}<span aria-hidden="true">&rarr;</span></a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product story",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "select", "id": "tone", "label": "Tone", "default": "light",
      "options": [ { "value": "light", "label": "Light paper" }, { "value": "stone", "label": "Soft stone" }, { "value": "dark", "label": "Dark" } ] },
    { "type": "select", "id": "media_side", "label": "Picture side", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "text", "id": "anchor", "label": "Anchor", "info": "For links to this chapter, e.g. goda. Letters and dashes." },
    { "type": "header", "content": "Picture" },
    { "type": "select", "id": "picture", "label": "Picture", "default": "photo",
      "info": "Studio image: the product's first studio packshot from Theme settings > Studio images, on a stone plate. Photograph: the image below.",
      "options": [ { "value": "photo", "label": "Photograph" }, { "value": "studio", "label": "Studio image" } ] },
    { "type": "checkbox", "id": "show_options", "label": "Show every option under the studio image", "default": false,
      "info": "A small packshot of each option (up to four), named. Studio image only." },
    { "type": "image_picker", "id": "photo", "label": "Photograph", "info": "A square product photograph (gets a square frame), or the real product in a real place, 16:9 or wider and at least 2400 px across (bled to the screen edge)." },
    { "type": "image_picker", "id": "photo_mobile", "label": "Photograph for phones (optional)", "info": "4:5, at least 1600 × 2000 px. Left empty, phones get a crop of the photograph above." },
    { "type": "video", "id": "video", "label": "Film (optional)", "info": "Silent, 6 to 10 seconds, loops cleanly. Uses the photograph as its poster." },
    { "type": "text", "id": "photo_alt", "label": "Picture description", "info": "For the photograph, used only if the image has no alt text in Content > Files; for the studio image, empty means the product and option name." },
    { "type": "text", "id": "position", "label": "Crop on wide screens", "default": "50% 50%", "info": "Where the frame centres on a wide photograph, as x% y%." },
    { "type": "text", "id": "position_mobile", "label": "Crop on phones", "info": "Same, for the taller phone frame. Empty: the wide-screen crop." },
    { "type": "checkbox", "id": "show_card", "label": "Show the specimen card", "default": true, "info": "Photographs only." },
    { "type": "select", "id": "card_corner", "label": "Specimen card corner", "default": "bottom-right",
      "info": "Put it where it covers nothing that matters, never over the product in the photograph.",
      "options": [ { "value": "bottom-left", "label": "Bottom left" }, { "value": "bottom-right", "label": "Bottom right" }, { "value": "top-left", "label": "Top left" }, { "value": "top-right", "label": "Top right" } ] },
    { "type": "text", "id": "card_line", "label": "Specimen card line", "info": "Empty: the product type." },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Empty: the product type." },
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Body", "info": "Two or three sentences about what it physically is and how it is used. Leave the maker's claims on the product page, labelled as theirs." },
    { "type": "checkbox", "id": "show_ladder", "label": "Show the multi-buy ladder", "default": true, "info": "The line-up already shows the multi-buy prices; the full ladder belongs on the product page." },
    { "type": "text", "id": "cta_label", "label": "Link text", "info": "Empty: Shop and the maker's name." },
    { "type": "select", "id": "cta_style", "label": "Link style", "default": "link",
      "options": [ { "value": "link", "label": "Text link" }, { "value": "button", "label": "Button" } ] },
    { "type": "text", "id": "link_label", "label": "Second text link" },
    { "type": "url", "id": "link_url", "label": "Second text link URL", "info": "Empty: the product page." }
  ],
  "blocks": [
    { "type": "fact", "name": "Fact", "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Figure", "info": "Short and physical: 15 ml, 9 g, 4 options." },
        { "type": "text", "id": "label", "label": "What it means" }
      ] }
  ],
  "presets": [{ "name": "Product story", "blocks": [{ "type": "fact" }, { "type": "fact" }, { "type": "fact" }] }]
}
{% endschema %}
