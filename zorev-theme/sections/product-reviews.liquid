{%- comment -%}
  Reviews.

  Judge.me is installed and keeps its data in product metafields. This
  section reads the count from there: with real reviews it renders
  Judge.me's own widget markup; with none it says so plainly.

  The empty state deliberately shows no stars at all. Five grey outline
  stars next to a product read at a glance as a rating, and there isn't one.
  Nothing here is ever written by the store — no names, no quotes, no
  scores. V15: warm ground (the product story above it is the stone
  band), the empty-state panel on stone.
{%- endcomment -%}
{%- liquid
  assign jd = product.metafields.judgeme.review_widget_data.value
  assign n = jd.number_of_reviews | default: 0
-%}
<section class="band zrev" id="reviews" aria-labelledby="zrev-h-{{ section.id }}">
  <div class="wrap zrev__in">
    <header class="zrev__head">
      <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      <h2 id="zrev-h-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    </header>

    {%- if n > 0 -%}
      <p class="zrev__sum">
        <strong>{{ jd.average_rating | round: 1 }}</strong> out of 5 &middot; {{ n }} {{ n | pluralize: 'review', 'reviews' }}
      </p>
      <div class="jdgm-widget jdgm-review-widget jdgm-outside-widget"
           data-id="{{ product.id }}"
           data-product-title="{{ product.title | escape }}">{{ product.metafields.judgeme.widget }}</div>
    {%- else -%}
      <div class="zrev__empty">
        <span class="zrev__ic" aria-hidden="true">{% render 'zicon', name: 'chat' %}</span>
        <div>
          <h3 class="zrev__t">No reviews yet.</h3>
          <p>ZOREV is new. This space will only ever show reviews from customers who have received an order &mdash; we don&rsquo;t write them, buy them, or copy them from other listings.</p>
          <p class="zrev__q">Questions before you buy? <a href="mailto:{{ settings.support_email | escape }}">{{ settings.support_email | escape }}</a> &mdash; a person answers.</p>
        </div>
      </div>
    {%- endif -%}
  </div>

  <style>
    .zrev__in{display:grid;gap:var(--zv-6)}
    @media(min-width:900px){.zrev__in{grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);align-items:start}}
    .zrev__head h2{margin:0}
    .zrev__sum{margin:0;font-size:var(--zv-t-lead);color:var(--zv-text)}
    .zrev__empty{display:grid;grid-template-columns:auto minmax(0,1fr);gap:var(--zv-4);
      padding:var(--zv-6);border-radius:var(--zv-r-lg);background:var(--zv-bg-sunken)}
    .zrev__ic{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;
      background:color-mix(in srgb, var(--zv-forest) 9%, var(--zv-bg-raised));color:var(--zv-forest)}
    .zrev__t{margin:0 0 var(--zv-2);font-size:var(--zv-t-h4)}
    .zrev__empty p{margin:0 0 var(--zv-3);color:var(--zv-text-2)}
    .zrev__empty p:last-child{margin-bottom:0}
    .zrev__q a{color:var(--zv-text);text-decoration:underline;text-underline-offset:3px;
      text-decoration-color:var(--zv-line-input);display:inline-flex;align-items:center;min-height:44px;overflow-wrap:anywhere}
    .zrev__q a:focus-visible{outline:2px solid var(--zv-focus);outline-offset:2px}
    @media(max-width:480px){.zrev__empty{grid-template-columns:1fr;padding:var(--zv-5)}}
  </style>
</section>
{% schema %}
{
  "name": "Product reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From real orders only" }
  ]
}
{% endschema %}
