{%- comment -%}
  Storytelling band — a full-bleed photograph with copy set into it.

  This is the homepage's closing photo band, the bookend to the hero: with
  "Detail" framing it shows the hero's own trail photograph closed in on
  its lower third, so the page ends in the same place it opened without
  repeating the opening frame. One button.

  The image is a real responsive <img> rather than a CSS background, so it
  participates in srcset and can be described for a screen reader. It is
  lazy — unlike the hero plate, this one is always below the fold.

  Asset slot (visual asset brief, C1 / C1-F / C1-M). "Photograph for phones"
  is a separate portrait crop, because the wide frame cropped to a 390px
  screen keeps only its middle; "Film" plays over the photograph while the
  band is on screen, with a pause button, never under reduced motion.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign img = s.image
  assign has_media = false
  if img != blank or s.video != blank
    assign has_media = true
  endif
-%}
<section class="zstory zv-dark{% if has_media == false %} zstory--flat{% endif %}{% if s.framing == 'detail' %} zstory--detail{% endif %}" data-zstory>
  {%- if has_media -%}
    {%- liquid
      comment
        sizes describe the picture: "Detail" framing scales it 1.24, and a
        wide photograph covering a tall phone band (no phone photograph) is
        drawn about 2.5 x the screen width (images.md §6.11, P5).
      endcomment
      assign zs_d = '100vw'
      assign zs_m = '100vw'
      if s.framing == 'detail'
        assign zs_d = '124vw'
        assign zs_m = '124vw'
      endif
      if s.image_mobile == blank
        if s.framing == 'detail'
          assign zs_d = '(max-width: 699px) 300vw, 124vw'
        else
          assign zs_d = '(max-width: 699px) 246vw, 100vw'
        endif
      endif
    -%}
    {% render 'zv-media', media: s.video, image: img, image_mobile: s.image_mobile, sizes: zs_d, sizes_mobile: zs_m, alt: s.image_alt, class: 'zstory__media', position: '50% 44%' %}
  {%- endif -%}
  <div class="zstory__veil" aria-hidden="true"></div>

  <div class="zv-wrap zstory__in">
    <div class="zstory__copy" data-zv-reveal>
      {%- if s.eyebrow != blank -%}
        <span class="zv-eyebrow zstory__eyebrow">{{ s.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if s.heading != blank -%}<h2 class="zstory__h">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.body != blank -%}<div class="zv-lead zstory__b">{{ s.body }}</div>{%- endif -%}
      {%- if s.cta_label != blank or s.cta2_label != blank -%}
        <div class="zstory__acts">
          {%- if s.cta_label != blank -%}
            <a class="zv-btn zstory__cta1" href="{{ s.cta_link | default: routes.all_products_collection_url }}">
              {{ s.cta_label | escape }}
            </a>
          {%- endif -%}
          {%- if s.cta2_label != blank -%}
            {%- capture pp -%}{% render 'pair-price' %}{%- endcapture -%}
            {%- unless pp == blank and s.cta2_label contains '[pair_price]' -%}
            <a class="zv-btn zv-btn--ghost zstory__cta" href="{{ s.cta2_link | default: routes.all_products_collection_url }}">
              {{ s.cta2_label | replace: '[pair_price]', pp | escape }}
            </a>
            {%- endunless -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <style>
    .zstory{
      position: relative; isolation: isolate; overflow: hidden;
      display: grid; align-items: end;
      min-height: 64vh; min-height: 64svh;
      background: var(--zv-bg);
      color: var(--zv-text);
    }
    @media (min-width: 900px){ .zstory{ min-height: 58vh; min-height: 58svh; align-items: center; } }
    .zstory--flat{ min-height: 44vh; min-height: 44svh; }
    /* No z-index on the media layer: the section is the stacking context
       (isolation), so the veil (1) and copy (2) sit over the picture while
       the film's pause button (3) still sits over all of them. */
    .zstory__media{
      position: absolute; inset: 0;
      width: 100%; height: 100%; background: transparent;
    }
    /* "Detail" framing: the same photograph as the hero, closed in on its
       lower third, so the closing band reads as a second look at the place
       rather than the opening frame repeated. */
    .zstory--detail .zstory__media img,
    .zstory--detail .zstory__media video{object-position:50% 84% !important;transform:scale(1.24);transform-origin:50% 88%}
    .zstory__veil{
      position: absolute; inset: 0; z-index: 1; pointer-events: none;
      background:
        linear-gradient(88deg, rgba(16,19,16,.84) 0%, rgba(16,19,16,.54) 40%, rgba(16,19,16,.22) 78%),
        linear-gradient(to top, rgba(16,19,16,.74) 0%, transparent 56%);
    }
    .zstory__in{
      position: relative; z-index: 2;
      padding-top: clamp(2.6rem, 7vw, 5rem);
      padding-bottom: clamp(2.6rem, 7vw, 5rem);
    }
    .zstory__copy{ display: flex; flex-direction: column; align-items: flex-start; gap: var(--zv-4); max-width: 30rem; }
    .zstory__eyebrow{ color: var(--zv-sand); }
    .zstory__h{
      margin: 0;
      font-family: var(--zv-serif); font-weight: 400;
      font-size: var(--zv-t-h2); line-height: var(--zv-lh-tight);
      letter-spacing: var(--zv-tr-tight);
      color: var(--zv-text); text-wrap: balance;
      text-shadow: 0 1px 22px color-mix(in srgb, var(--zv-bg) 55%, transparent);
    }
    .zstory__b{ color: var(--zv-sand); text-shadow: 0 1px 16px color-mix(in srgb, var(--zv-bg) 50%, transparent); }
    .zstory__b > :first-child{ margin-top: 0; }
    .zstory__b > :last-child{ margin-bottom: 0; }
    /* Ghost on a photograph: the band's ghost edge plus a faint fill, exactly
       as the hero's secondary button does. */
    .zstory__acts{display:flex;flex-wrap:wrap;gap:var(--zv-3)}
    @media(max-width:420px){ .zstory__acts{display:grid;width:100%} .zstory__acts .zv-btn{justify-content:center} }
    .zstory__cta{
      color: var(--zv-text);
      border-color: var(--zv-ghost-edge, var(--zv-hairline-2));
      background: color-mix(in srgb, var(--zv-bg) 22%, transparent);
    }
    @media (hover: hover) and (pointer: fine){
      .zstory__cta:hover{ background: color-mix(in srgb, var(--zv-text) 14%, transparent); border-color: var(--zv-text); box-shadow: none; }
    }
  </style>
</section>
{% schema %}
{
  "name": "Story band",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photograph",
      "info": "Wide and dark on the left, where the copy sits. Lazy-loaded — do not use this section above the fold." },
    { "type": "text", "id": "image_alt", "label": "Photograph description",
      "info": "Used only if the image has no alt text in Content > Files." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "cta_label", "label": "Button" },
    { "type": "text", "id": "cta2_label", "label": "Second button" },
    { "type": "url", "id": "cta2_link", "label": "Second button link" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "image_picker", "id": "image_mobile", "label": "Photograph for phones (optional)",
      "info": "Portrait 4:5, at least 1600 × 2000 px, with the quiet area in the lower half where the copy sits on a phone (brief C1-M). Left empty, phones get a crop of the photograph above." },
    { "type": "video", "id": "video", "label": "Film (optional)",
      "info": "8 to 12 seconds, silent, loops cleanly, same framing as the photograph (brief C1-F). Plays only while on screen and never for visitors who ask for reduced motion." },
    { "type": "select", "id": "framing", "label": "Photo framing", "default": "full",
      "options": [ { "value": "full", "label": "Full frame" }, { "value": "detail", "label": "Detail (closer crop)" } ],
      "info": "Use Detail when this band repeats a photo used higher up the page." }
  ],
  "presets": [{ "name": "Story band" }]
}
{% endschema %}
