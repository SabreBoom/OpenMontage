{%- comment -%}
  Announcement / trust bar.

  Rendered from layout/theme.liquid ABOVE the header, in normal flow: it
  scrolls away and the sticky header takes over. That only works because the
  header's overlay mode is off (config/settings_data.json) — a fixed overlay
  header would cover this bar on first paint.

  Every claim here has to be true of the real Shopify settings. As of this
  build both delivery zones on the default profile ("United States" and
  "All of world") carry an ACTIVE $0.00 rate with no minimum, and the $5
  "Express protection shipping" rates are switched OFF — so free worldwide
  shipping is a fact about the store, not a pitch.

  There is deliberately no delivery window anywhere in this theme. The shop
  runs flat manual rates with no carrier service, so there is no transit
  estimate to quote, and a number invented here is one the customer will
  hold the store to.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- if s.claim_1 != blank or s.claim_2 != blank or s.claim_3 != blank -%}
<aside class="zann" aria-label="Store information">
  <div class="zv-wrap zann__in">
    <ul class="zann__list" role="list">
      {%- if s.claim_1 != blank -%}<li>{{ s.claim_1 | escape }}</li>{%- endif -%}
      {%- if s.claim_2 != blank -%}<li>{{ s.claim_2 | escape }}</li>{%- endif -%}
      {%- if s.claim_3 != blank -%}<li>{{ s.claim_3 | escape }}</li>{%- endif -%}
    </ul>
  </div>
</aside>

<style>
  /* Warm white on forest measures 11.26:1, so this clears WCAG 1.4.3 even
     at the small-caps size it is set in. */
  .zann{
    background: var(--zv-forest);
    color: var(--zv-warm);
    padding-top: env(safe-area-inset-top, 0px);
  }
  .zann__in{ display: flex; align-items: center; justify-content: center; }
  .zann__list{
    margin: 0; padding: .42rem 0; list-style: none;
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 2px var(--zv-5);
    font-family: var(--zv-sans); font-size: var(--zv-t-micro); font-weight: 600;
    letter-spacing: var(--zv-tr-caps); text-transform: uppercase;
    text-align: center;
  }
  .zann__list li{ position: relative; }
  /* Dot separators as ::before, not borders — a border would also appear at
     the start of a wrapped row. */
  .zann__list li + li::before{
    content: ''; position: absolute; top: 50%; left: calc(var(--zv-5) / -2);
    width: 3px; height: 3px; border-radius: 50%;
    background: rgba(244,242,236,.55);
    transform: translate(-50%, -50%);
  }
  /* One claim on a phone. Rotating them would be animated text, and three
     wrapped lines of caps is a 60px band sitting on top of a 64px header. */
  @media (max-width: 719px){
    .zann__list li + li{ display: none; }
  }
</style>
{%- endif -%}
{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "paragraph", "content": "Shown above the header on every page. Only the first claim appears on phones. Check every line against Settings > Shipping before you change it — an untrue claim here is on every page of the store." },
    { "type": "text", "id": "claim_1", "label": "Claim 1", "default": "Free shipping worldwide" },
    { "type": "text", "id": "claim_2", "label": "Claim 2", "default": "Ships next business day" },
    { "type": "text", "id": "claim_3", "label": "Claim 3", "default": "GODA + HOYGI · $59 together" }
  ]
}
{% endschema %}
