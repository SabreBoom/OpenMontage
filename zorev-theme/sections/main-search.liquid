{%- comment -%}
  Search.

  The field has a real <label>, not a placeholder standing in for one: a
  placeholder disappears the moment you type, which leaves anyone using a
  screen reader — or anyone who got distracted — with an unlabelled box.
{%- endcomment -%}
<section class="zv-section">
  <div class="zv-wrap">
    <header class="zsec__head" data-zv-reveal>
      <h1 class="zv-h1">Search</h1>
    </header>

    <form class="zsearch" action="{{ routes.search_url }}" method="get" role="search">
      <div class="zsearch__field">
        <label class="zsearch__label" for="zsearch-q">What are you looking for?</label>
        <input class="zsearch__input" id="zsearch-q" type="search" name="q"
               value="{{ search.terms | escape }}" autocomplete="off"
               enterkeyhint="search">
      </div>
      <button class="zv-btn zsearch__go" type="submit">Search</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        <p class="zv-eyebrow zsearch__count" aria-live="polite">
          {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}
          {%- if search.terms != blank %} for &ldquo;{{ search.terms | escape }}&rdquo;{% endif -%}
        </p>

        {%- if search.results_count > 0 -%}
          {%- comment -%}
            Products as cards in the grid; pages and articles as a compact
            list under it. Mixed into one grid, a text result was stretched
            to the height of a product card and read as an empty stone box.
          {%- endcomment -%}
          {%- liquid
            assign n_products = 0
            assign n_other = 0
            for item in search.results
              if item.object_type == 'product'
                assign n_products = n_products | plus: 1
              else
                assign n_other = n_other | plus: 1
              endif
            endfor
            assign other_level = 2
            if n_products > 0
              assign other_level = 3
            endif
          -%}
          {%- if n_products > 0 -%}
            <div class="zgrid zgrid--3 zsearch__grid">
              {%- assign first_card = true -%}
              {%- for item in search.results -%}
                {%- if item.object_type == 'product' -%}
                  {% render 'product-card', card_product: item, eager: first_card, heading_level: 2,
                     sizes: '(min-width: 1200px) 380px, (min-width: 1000px) 30vw, (min-width: 560px) 45vw, 88vw' %}
                  {%- assign first_card = false -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if n_other > 0 -%}
            {%- if n_products > 0 -%}
              <h2 class="zv-h3 zsearch__sub">Pages</h2>
            {%- endif -%}
            <ul class="zsearch__list" role="list">
              {%- for item in search.results -%}
                {%- unless item.object_type == 'product' -%}
                  <li>
                    <a class="zresult zsearch__item" href="{{ item.url }}">
                      <span class="zv-eyebrow">{{ item.object_type | capitalize }}</span>
                      <h{{ other_level }} class="zresult__t">{{ item.title | escape }}</h{{ other_level }}>
                      {%- if item.content != blank -%}
                        <p class="zv-fine">{{ item.content | strip_html | truncatewords: 24 }}</p>
                      {%- endif -%}
                    </a>
                  </li>
                {%- endunless -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if paginate.pages > 1 -%}
            <nav class="zpag" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
          {%- endif -%}
        {%- else -%}
          <div class="zempty">
            <p class="zv-body">Nothing matched that. There are only two products, so it may be quicker to look at both.</p>
            <a class="zv-btn" href="{{ routes.all_products_collection_url }}">See both</a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

<style>
  /* Packshots on the card plates stand on the plate's floor shadow
     (snippets/product-card; same rule as the collection page). */
  .zcard__fig.zv-studio .zcard__img{object-position:50% 100%}
  .zsearch__grid{align-items:start}
  /* pages and articles: one compact column of text results */
  .zsearch__sub{margin:var(--zv-7) 0 var(--zv-4)}
  .zsearch__list{list-style:none;margin:0;padding:0;display:grid;gap:var(--zv-3);max-width:var(--zv-container-narrow)}
  .zsearch__grid + .zsearch__list{margin-top:var(--zv-7)}
  .zsearch__item{padding:var(--zv-4) var(--zv-5);gap:var(--zv-1)}
  .zsearch__item p{margin:0}
</style>

{% schema %}
{ "name": "Search", "tag": "section", "settings": [] }
{% endschema %}